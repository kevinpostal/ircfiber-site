name "irc-fiber-backend"
description "IRC Fiber backend — vibe.d REST API + WebSocket + Admin"
authors "IRC Fiber Team"
copyright "Copyright © 2026 IRC Fiber"
license "MIT"

compiler "ldc2"

targetType "executable"
targetName "irc-fiber"
sourcePaths "source"
importPaths "source"

dependency "irc-fiber-common" path="../common" version="~>0.3.0"
dependency "vibe-d" version="~>0.10.0"
dependency "vibe-d:redis" version="~>0.10.0"
dependency "vibe-d:mongodb" version="~>0.10.0"
dependency "diet-ng" version="~>1.8"

configuration "application" {
    targetType "executable"
    targetName "irc-fiber"
    mainSourceFile "source/app.d"
    versions "VibeUseFibers"
}

configuration "debug" {
    targetType "executable"
    targetName "irc-fiber"
    mainSourceFile "source/app.d"
    versions "VibeUseFibers" "DietUseLive"
    dflags "-d"
}

configuration "release" {
    targetType "executable"
    targetName "irc-fiber"
    mainSourceFile "source/app.d"
    versions "VibeUseFibers"
    dflags "-d"
}

configuration "gateway" {
    targetType "executable"
    targetName "irc-fiber-gateway"
    mainSourceFile "source/app.d"
    versions "VibeUseFibers" "GatewayOnly"
}

// Library config for engine test configs that import backend modules
// (ircfiber.api.rest / ircfiber.api.session / ircfiber.auth etc.) after the
// split. Executable configs cannot be consumed as module sources by dub.
configuration "library" {
    targetType "library"
}

// Pure-code unit test for the bouncer wire helpers (no Redis/Mongo needed):
//   dub --root=backend build --config=bnc-wire-test && ./backend/bnc-wire-test
configuration "bnc-wire-test" {
    targetType "executable"
    targetName "bnc-wire-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/bnc/wire.d" "source/ircfiber/bnc/format.d"
    mainSourceFile "tests/bnc_wire_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the IRCd admin parsing/redaction helpers
// (no Redis/Mongo/IRCd needed):
//   dub --root=backend build --config=ircd-test && ./backend/ircd-test
configuration "ircd-test" {
    targetType "executable"
    targetName "ircd-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/web/admin/ircd.d" "source/ircfiber/web/admin/helpers.d" "source/ircfiber/web/common.d" "source/ircfiber/env.d"
    mainSourceFile "tests/ircd_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the admin Logs SigNoz proxy reshape/sanitize
// helpers (no SigNoz needed):
//   dub --root=backend build --config=logs-test && ./backend/logs-test
configuration "logs-test" {
    targetType "executable"
    targetName "logs-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/web/admin/logs.d" "source/ircfiber/web/admin/helpers.d" "source/ircfiber/web/common.d" "source/ircfiber/env.d"
    mainSourceFile "tests/logs_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the admin Backups k8s/schedule/freshness helpers
// (no k8s, Redis or Mongo needed):
configuration "backups-test" {
    targetType "executable"
    targetName "backups-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/web/admin/backups.d" "source/ircfiber/web/admin/helpers.d" "source/ircfiber/web/common.d" "source/ircfiber/env.d"
    mainSourceFile "tests/backups_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the Mullvad pool / egress id helpers shared by
// the admin API and the user "Connect via" picker (no SOCKS/Redis/Mongo):
//   dub --root=backend build --config=egress-test && ./backend/egress-test
configuration "egress-test" {
    targetType "executable"
    targetName "egress-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/egress.d"
    mainSourceFile "tests/egress_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the user-facing login-sessions view model behind
// Settings → Sessions (`GET /api/me/sessions`) — grouping, ordering, expiry
// maths and the "session ids never leave the server" rule. No Redis/Mongo/WS:
//   dub --root=backend build --config=sessions-view-test && ./backend/sessions-view-test
configuration "sessions-view-test" {
    targetType "executable"
    targetName "sessions-view-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/web/sessions_view.d"
    mainSourceFile "tests/sessions_view_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the #support bot formatting / command parsing
// and the outbox event JSON (no Redis/Mongo/IRCd needed):
//   dub --root=backend build --config=support-format-test && ./backend/support-format-test
configuration "support-format-test" {
    targetType "executable"
    targetName "support-format-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/support/format.d" "source/ircfiber/support/events.d" "source/ircfiber/support/json.d"
    mainSourceFile "tests/support_format_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the #staff log bot: the InspIRCd connect-notice
// parser, the private-IP test and the announcement formatter, plus the
// outbox event JSON (no Redis/Mongo/IRCd/ipinfo needed):
//   dub --root=backend build --config=logs-format-test && ./backend/logs-format-test
configuration "logs-format-test" {
    targetType "executable"
    targetName "logs-format-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/logs/format.d" "source/ircfiber/logs/events.d" "source/ircfiber/logs/backup_announce.d" "source/ircfiber/web/admin/backups.d" "source/ircfiber/web/admin/helpers.d" "source/ircfiber/web/common.d" "source/ircfiber/env.d" "source/ircfiber/support/format.d" "source/ircfiber/support/events.d" "source/ircfiber/support/json.d" "source/ircfiber/ipintel/record.d" "source/ircfiber/ipintel/assemble.d" "source/ircfiber/ipintel/cidr.d"
    mainSourceFile "tests/logs_format_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for FiberEye: the quit-notice parser, the IPv6 /64
// grouping, the Z-line mask matcher, the rule engine and the strike
// escalation (no Redis/Mongo/IRCd needed):
//   dub --root=backend build --config=fibereye-test && ./backend/fibereye-test
configuration "fibereye-test" {
    targetType "executable"
    targetName "fibereye-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/fibereye/format.d" "source/ircfiber/fibereye/rules.d" "source/ircfiber/fibereye/events.d" "source/ircfiber/fibereye/ruleset.d" "source/ircfiber/logs/format.d" "source/ircfiber/logs/events.d" "source/ircfiber/support/format.d" "source/ircfiber/support/json.d" "source/ircfiber/ipintel/record.d" "source/ircfiber/ipintel/assemble.d" "source/ircfiber/ipintel/cidr.d"
    mainSourceFile "tests/fibereye_test.d"
    versions "VibeUseFibers"
}
// Pure-code unit test for the gateway bot nick reclaim: the Guest-nick
// detector, the NickServ notice classifier and the +r MODE grant check
// (no Redis/Mongo/IRCd needed):
//   dub --root=backend build --config=bot-nick-test && ./backend/bot-nick-test
configuration "bot-nick-test" {
    targetType "executable"
    targetName "bot-nick-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/bots/nick.d"
    mainSourceFile "tests/bot_nick_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the IP-intelligence assembler: per-source
// mappers, field ownership, the classification vote, the record JSON round
// trip and the CIDR matcher (no Redis/Mongo/network needed):
//   dub --root=backend build --config=ipintel-test && ./backend/ipintel-test
configuration "ipintel-test" {
    targetType "executable"
    targetName "ipintel-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/ipintel/record.d" "source/ircfiber/ipintel/assemble.d" "source/ircfiber/ipintel/cidr.d"
    mainSourceFile "tests/ipintel_test.d"
    versions "VibeUseFibers"
}

// Pure-code unit test for the Anope XML-RPC wire helpers plus the NickServ
// account/nick/password helpers (built with -unittest so the `@("…")`
// unittest blocks in services/accounts.d run before main; no Anope, Redis
// or Mongo needed):
//   dub --root=backend build --config=services-test && ./backend/services-test
configuration "services-test" {
    targetType "executable"
    targetName "services-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/services/anope.d" "source/ircfiber/services/accounts.d" "source/ircfiber/services/anope_db.d" "source/ircfiber/services/nickserv_sync.d" "source/ircfiber/mail.d" "source/ircfiber/env.d"
    mainSourceFile "tests/services_test.d"
    versions "VibeUseFibers"
    buildOptions "unittests"
}

// Pure-code unit test for the signup email verification helpers
// (ircfiber.mail sender.net payload/verdict, ircfiber.signup token/link/
// email/pending-record shapes; no Redis, Mongo or network needed):
//   dub --root=backend build --config=signup-test && ./backend/signup-test
configuration "signup-test" {
    targetType "executable"
    targetName "signup-test"
    sourcePaths "tests"
    importPaths "source" "tests"
    sourceFiles "source/ircfiber/mail.d" "source/ircfiber/mail_events.d" "source/ircfiber/mail_campaigns.d" "source/ircfiber/logs/events.d" "source/ircfiber/signup.d" "source/ircfiber/invites.d" "source/ircfiber/services/accounts.d" "source/ircfiber/services/anope.d" "source/ircfiber/services/anope_db.d" "source/ircfiber/env.d" "source/ircfiber/web/admin/emails.d" "source/ircfiber/web/admin/helpers.d" "source/ircfiber/web/common.d"
    mainSourceFile "tests/signup_test.d"
    versions "VibeUseFibers"
    buildOptions "unittests"
}
