extends layout

block head
  link(rel="stylesheet", href="/public/style.css")
  style.
    :root {
      --bg:           #000;
      --surface:      #111;
      --surface-2:    #0a0a0a;
      --line:         #222;
      --ink:          #d1d5db;
      --ink-soft:     #8b949e;
      --ink-muted:    #525252;
      --accent:       #3291ff;
      --green:        #3fb950;
      --orange:       #d29922;
    }
    html, body {
      background: var(--bg); color: var(--ink);
      margin: 0; padding: 0; overflow: hidden; height: 100%;
    }
    * { font-family: 'Hack', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }

    .landing {
      position: fixed; inset: 0;
      display: flex; overflow: hidden;
    }

    .landing-main {
      flex: 1; display: flex; flex-direction: column;
      min-width: 0; overflow: hidden; order: 2;
    }
    .landing-bufferhead {
      display: flex; align-items: center;
      padding: 8px 16px 8px 20px;
      font-size: 12px; line-height: 18px; color: var(--ink-soft);
      background: #000;
      border-bottom: 1px solid var(--line);
      flex-shrink: 0;
    }
    .landing-bufferhead__info { flex: 1; min-width: 0; }
    .landing-bufferhead__channel { display: inline; font-size: 13px; font-weight: 700; color: var(--ink); }
    .landing-bufferhead__topic { display: inline; font-size: 11px; color: var(--ink-muted); margin-left: 8px; }
    .landing-bufferhead__controls { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .landing-bufferhead__controls .count { font-size: 11px; color: var(--ink-muted); }
    .landing-bufferhead__controls .btn {
      padding: 2px 8px; font-size: 11px;
      border-radius: 2px; background: var(--surface);
      color: var(--ink-soft); border: 1px solid var(--line);
      cursor: default;
    }

    .landing-messages {
      flex: 1; padding: 6px 0; overflow: hidden; background: #000;
    }
    .landing-msg {
      display: flex; align-items: baseline; gap: 4px;
      padding: 1px 16px; font-size: 12px; line-height: 18px;
      min-height: 20px;
    }
    .landing-msg__time { color: var(--ink-muted); min-width: 44px; text-align: right; flex-shrink: 0; font-size: 10px; }
    .landing-msg__nick { font-weight: 700; min-width: 52px; text-align: right; flex-shrink: 0; font-size: 11px; }
    .nick-0 { color: #ff4855; } .nick-1 { color: #f5a623; } .nick-2 { color: #f6e27e; }
    .nick-3 { color: #50c878; } .nick-4 { color: #4a90d9; } .nick-5 { color: #b388ff; }
    .landing-msg__text { color: var(--ink); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px; }
    .landing-msg__text .hl { color: var(--accent); }

    .landing-input { padding: 0 12px 10px; background: #000; flex-shrink: 0; }
    .landing-input__field {
      display: flex; align-items: center; gap: 6px;
      padding: 5px 8px; background: var(--surface);
      border: 1px solid var(--line);
    }
    .landing-input__field .prefix { color: var(--ink-muted); font-size: 10px; }
    .landing-input__field .text { flex: 1; font-size: 11px; color: var(--ink-muted); }
    .landing-input__field .icon { color: var(--ink-muted); font-size: 12px; }

    .landing-members {
      width: 140px; min-width: 140px; height: 100%;
      background: #0d1117;
      border-left: 1px solid var(--line);
      display: flex; flex-direction: column; overflow: hidden;
      flex-shrink: 0; order: 3;
    }
    .landing-members__title {
      font-size: 9px; font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--ink-muted); padding: 8px 12px 4px; flex-shrink: 0;
    }
    .landing-member {
      display: flex; align-items: center; gap: 6px;
      padding: 1px 12px; font-size: 11px; color: var(--ink-soft);
    }
    .landing-member .s { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .landing-member .s.on { background: var(--green); }
    .landing-member .s.away { background: var(--orange); }
    .landing-member .s.off { background: var(--ink-muted); }
    .landing-member .n { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .landing-sidebar {
      width: 200px; min-width: 200px; height: 100%;
      background: #000;
      position: relative;
      display: flex; flex-direction: column; overflow: hidden;
      flex-shrink: 0; order: 1;
      border-right: 5px solid #111;
    }
    .landing-sidebar__brand {
      display: flex; align-items: center; gap: 8px;
      padding: 14px 0 14px 12px;
      border-bottom: 1px solid var(--line); flex-shrink: 0;
    }
    .landing-sidebar__brand svg { display: block; }
    .landing-sidebar__brand .t { font-size: 14px; font-weight: 700; color: var(--ink); }
    .landing-sidebar__brand .f { color: var(--accent); }

    .landing-network-list { flex: 1; overflow-y: auto; padding: 4px 0 0 8px; }
    .landing-network { margin-bottom: 8px; }
    .landing-network__h {
      display: flex; align-items: center;
      padding: 2px 0 2px 4px;
      font-size: 12px; color: var(--ink-soft); line-height: 18px;
    }
    .landing-network__h i { font-size: 10px; color: var(--ink-muted); margin-right: 4px; }
    .landing-network__h .l { padding: 2px 6px; }
    .landing-channel {
      display: flex; align-items: center;
      padding: 2px 0 2px 16px;
      font-size: 12px; color: var(--ink-muted); line-height: 18px;
    }
    .landing-channel .l { padding: 0 6px; }
    .landing-channel.active { color: var(--ink); }
    .landing-channel .st {
      display: inline-block; width: 6px; height: 6px;
      border-radius: 50%; margin-right: 4px; flex-shrink: 0;
    }
    .landing-channel .st.on { background: var(--green); }
    .landing-channel .st.away { background: var(--orange); }
    .landing-channel .st.off { background: var(--ink-muted); }

    .landing-sidebar__footer {
      padding: 8px 12px; border-top: 1px solid var(--line);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; flex-shrink: 0;
    }
    .landing-sidebar__footer .s { color: var(--green); font-size: 10px; }
    .landing-sidebar__footer .u { color: var(--ink-soft); display: flex; align-items: center; gap: 4px; }

    .landing-overlay {
      position: fixed; inset: 0; z-index: 100;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      animation: fade-in 0.2s ease-out;
    }
    .auth-card {
      width: 100%; max-width: 400px;
      background: #0a0a0a;
      border: 1px solid var(--line);
      padding: 2.5rem;
      animation: rise 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .auth-brand { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 2rem; text-decoration: none; }
    .auth-brand svg { display: block; }
    .auth-brand .t { font-size: 18px; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; }
    .auth-brand .f { color: var(--accent); }
    .auth-heading { text-align: center; font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 4px; letter-spacing: -0.01em; }
    .auth-sub { text-align: center; font-size: 12px; color: var(--ink-muted); margin: 0 0 2rem; line-height: 1.5; }
    .auth-error { display: flex; align-items: flex-start; gap: 6px; padding: 8px 10px; margin-bottom: 16px; background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2); color: #f87171; font-size: 11px; line-height: 1.4; }
    .auth-error::before { content: "!"; flex: 0 0 16px; width: 16px; height: 16px; border-radius: 50%; background: #f87171; color: #000; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 10px; }
    .auth-form { display: flex; flex-direction: column; gap: 14px; }
    .auth-field { display: flex; flex-direction: column; gap: 6px; }
    .auth-field label { font-size: 11px; font-weight: 600; color: var(--ink-soft); letter-spacing: 0.03em; }
    .auth-field input { width: 100%; padding: 10px 12px; background: #000; border: 1px solid var(--line); color: var(--ink); font-size: 13px; box-sizing: border-box; }
    .auth-field input::placeholder { color: var(--ink-muted); }
    .auth-field input:focus { outline: none; border-color: var(--accent); }
    .auth-button { width: 100%; padding: 10px 16px; margin-top: 6px; background: var(--accent); color: #fff; border: none; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.02em; transition: background 0.15s ease; }
    .auth-button:hover { background: #4a9eff; }
    .auth-button:active { opacity: 0.9; }
    /* Social OAuth (rendered by the scripts-block fetch when a provider is
       configured; the :empty rule keeps the card password-only otherwise):
       a compact icon row — GitHub/Google brand chips plus one picker popup
       holding every other provider. */
    .auth-oauth { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
    .auth-oauth:empty { display: none; }
    .auth-oauth__label { text-align: center; font-size: 11px; color: var(--ink-muted); letter-spacing: 0.03em; }
    .auth-oauth__row { position: relative; display: flex; align-items: center; justify-content: center; gap: 10px; }
    .auth-oauth__icon { display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 40px; padding: 0; background: #111; color: var(--ink); border: 1px solid var(--line); cursor: pointer; transition: background 0.15s ease, border-color 0.15s ease; }
    .auth-oauth__icon:hover { background: #161616; border-color: var(--accent); }
    .auth-oauth__icon:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(50, 145, 255, 0.35); }
    .auth-oauth__icon svg { display: block; width: 18px; height: 18px; }
    .auth-oauth__menu { display: none; position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); z-index: 10; min-width: 180px; padding: 6px; background: #0d0d0d; border: 1px solid var(--line); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6); }
    .auth-oauth__menu.open { display: block; }
    .auth-oauth__menu a { display: block; padding: 9px 10px; color: var(--ink); font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; }
    .auth-oauth__menu a:hover { background: #161616; color: #fff; }
    .auth-oauth__divider { display: flex; align-items: center; gap: 10px; color: var(--ink-muted); font-size: 11px; }
    .auth-oauth__divider::before, .auth-oauth__divider::after { content: ''; flex: 1; border-top: 1px solid var(--line); }
    .auth-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-muted); }
    .auth-meta a { color: var(--accent); text-decoration: none; }
    .auth-meta a:hover { text-decoration: underline; }
    .auth-foot { text-align: center; margin-top: 1.5rem; font-size: 10px; color: var(--ink-muted); letter-spacing: 0.05em; }

    ::view-transition-old(root),
    ::view-transition-new(root) { animation-duration: 0.25s; }
    .auth-card { view-transition-name: auth-card; }
    .landing-overlay { view-transition-name: overlay; }
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 640px) { .landing-sidebar, .landing-members { display: none; } .landing-bufferhead__topic { display: none; } .auth-card { padding: 1.5rem; } }
    @media (prefers-reduced-motion: reduce) { .landing-overlay, .auth-card { animation: none !important; } }

block body
  .landing
    .landing-main
      .landing-bufferhead
        .landing-bufferhead__info
          span.landing-bufferhead__channel #general
          span.landing-bufferhead__topic Welcome to the IRC Fiber channel
        .landing-bufferhead__controls
          span.count 6
          span.btn Archive

      .landing-messages
        .landing-msg
          span.landing-msg__time 09:41
          span.landing-msg__nick.nick-0 alice
          span.landing-msg__text morning everyone
        .landing-msg
          span.landing-msg__time 09:42
          span.landing-msg__nick.nick-1 bob
          span.landing-msg__text new release is looking sharp
        .landing-msg
          span.landing-msg__time 09:43
          span.landing-msg__nick.nick-3 carol
          span.landing-msg__text search performance is much better now
        .landing-msg
          span.landing-msg__time 09:44
          span.landing-msg__nick.nick-0 alice
          span.landing-msg__text agreed — upload panel is clean
        .landing-msg
          span.landing-msg__time 09:46
          span.landing-msg__nick.nick-2 dave
          span.landing-msg__text any ETA on mobile support?

      .landing-input
        .landing-input__field
          span.prefix &gt;
          span.text Message #general…

    .landing-members
      .landing-members__title ONLINE — 6
      .landing-member
        span.s.on
        span.n alice
      .landing-member
        span.s.on
        span.n bob
      .landing-member
        span.s.away
        span.n carol
      .landing-member
        span.s.on
        span.n dave
      .landing-member
        span.s.on
        span.n eve
      .landing-member
        span.s.off
        span.n frank

    .landing-sidebar
      .landing-sidebar__brand
        svg(width="20", height="20", viewBox="0 0 20 20", fill="none", xmlns="http://www.w3.org/2000/svg")
          rect(x="1", y="3", width="18", height="14", rx="2", fill="#3291ff", opacity="0.9")
          path(d="M5 7h10M5 10h7M5 13h4", stroke="#000", stroke-width="1.5", stroke-linecap="round")
        span.t IRC&thinsp;<span class="f">Fiber</span>

      .landing-network-list
        .landing-network
          .landing-network__h
            i.fa.fa-globe(aria-hidden="true")
            span.l libera.chat
          .landing-channel.active
            span.st.on
            span.l #general
          .landing-channel
            span.st.on
            span.l #random
          .landing-channel
            span.st.away
            span.l #dev

      .landing-sidebar__footer
        span.s ● connected
        span.u alice

  .landing-overlay
    .auth-card
      .auth-brand
        svg(width="22", height="22", viewBox="0 0 20 20", fill="none", xmlns="http://www.w3.org/2000/svg")
          rect(x="1", y="3", width="18", height="14", rx="2", fill="#3291ff", opacity="0.9")
          path(d="M5 7h10M5 10h7M5 13h4", stroke="#000", stroke-width="1.5", stroke-linecap="round")
        span.t IRC&thinsp;<span class="f">Fiber</span>
      h1.auth-heading Create an account
      p.auth-sub Always connected from any device

      - if (authError.length > 0)
        .auth-error(role="alert") #{authError}
      .auth-oauth#oauth-providers

      form.auth-form(method="POST", action="/register", autocomplete="on", novalidate)
        .auth-field
          label(for="username") Username
          input#username(type="text", name="username", placeholder="choose a handle", required, autofocus, autocomplete="username", spellcheck="false", minlength="2", maxlength="30", pattern="[A-Za-z0-9_\\-]+")
        .auth-field
          label(for="email") Email
          input#email(type="email", name="email", placeholder="you@example.com", required, autocomplete="email", spellcheck="false")
        .auth-field
          label(for="password") Password
          input#password(type="password", name="password", placeholder="at least 8 characters", required, autocomplete="new-password", minlength="8")

        button.auth-button(type="submit") Create account

      .auth-meta
        span Already have an account?
        a(href="/login") Sign in &rarr;

      p.auth-foot // fibre.always.connected

block scripts
  script.
    (function() {
      if (!document.startViewTransition) return;
      document.addEventListener('click', function(e) {
        var a = e.target.closest('a[href="/register"], a[href="/login"]');
        if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        document.startViewTransition(function() {
          location.href = a.getAttribute('href');
        });
      });
    })();
    // Social OAuth (progressive enhancement): fetch the configured providers
    // and render a compact icon row — GitHub and Google as brand icons, every
    // other provider behind one picker popup — the same shape the landing
    // topbar uses, so the card never grows one full-width button per provider.
    // Renders nothing when no provider is configured (the .auth-oauth:empty
    // rule keeps the card password-only).
    (function() {
      var box = document.getElementById('oauth-providers');
      if (!box || !window.fetch) return;
      var OAUTH_ICON_SVG = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="5" r="2.6"/><path d="M2.8 13.4c.7-2.6 2.8-4 5.2-4s4.5 1.4 5.2 4"/></svg>';
      var OAUTH_BRAND_SVG = {
        github: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>',
        google: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/><path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/></svg>'
      };
      function isDirect(name) { return name === 'github' || name === 'google'; }
      function chip(p, svg) {
        var a = document.createElement('a');
        a.className = 'auth-oauth__icon';
        a.href = '/auth/' + encodeURIComponent(p.name);
        a.setAttribute('data-provider', p.name);
        a.setAttribute('aria-label', 'Continue with ' + p.label);
        a.setAttribute('title', 'Continue with ' + p.label);
        a.innerHTML = svg;
        return a;
      }
      fetch('/api/auth/providers', { credentials: 'same-origin' }).then(function(res) {
        if (!res.ok) return null;
        return res.json();
      }).then(function(data) {
        if (!data || !Array.isArray(data.providers)) return;
        var valid = data.providers.filter(function(p) {
          return p && typeof p.name === 'string' && typeof p.label === 'string';
        });
        if (!valid.length) return;
        var order = { github: 0, google: 1 };
        var direct = valid.filter(function(p) { return isDirect(p.name); })
                          .sort(function(a, b) { return order[a.name] - order[b.name]; });
        var rest = valid.filter(function(p) { return !isDirect(p.name); });

        var caption = document.createElement('div');
        caption.className = 'auth-oauth__label';
        caption.textContent = 'Continue with';
        box.appendChild(caption);

        var row = document.createElement('div');
        row.className = 'auth-oauth__row';
        direct.forEach(function(p) { row.appendChild(chip(p, OAUTH_BRAND_SVG[p.name])); });
        if (rest.length === 1) {
          row.appendChild(chip(rest[0], OAUTH_ICON_SVG));
        } else if (rest.length > 1) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'auth-oauth__icon';
          btn.setAttribute('aria-haspopup', 'menu');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-controls', 'oauth-more-menu');
          btn.setAttribute('aria-label', 'More sign-in options');
          btn.setAttribute('title', 'More sign-in options');
          btn.innerHTML = OAUTH_ICON_SVG;
          var menu = document.createElement('div');
          menu.className = 'auth-oauth__menu';
          menu.id = 'oauth-more-menu';
          menu.setAttribute('role', 'menu');
          rest.forEach(function(p) {
            var item = document.createElement('a');
            item.href = '/auth/' + encodeURIComponent(p.name);
            item.setAttribute('data-provider', p.name);
            item.setAttribute('role', 'menuitem');
            item.textContent = p.label;
            menu.appendChild(item);
          });
          function closeMenu() {
            menu.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
          }
          btn.addEventListener('click', function(ev) {
            ev.stopPropagation();
            var open = menu.classList.toggle('open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          menu.addEventListener('click', function(ev) { ev.stopPropagation(); });
          document.addEventListener('click', closeMenu);
          document.addEventListener('keydown', function(ev) {
            if (ev.key === 'Escape' && menu.classList.contains('open')) {
              closeMenu();
              btn.focus();
            }
          });
          row.appendChild(btn);
          row.appendChild(menu);
        }
        box.appendChild(row);

        var div = document.createElement('div');
        div.className = 'auth-oauth__divider';
        div.setAttribute('aria-hidden', 'true');
        var span = document.createElement('span');
        span.textContent = 'or';
        div.appendChild(span);
        box.appendChild(div);
      }).catch(function() {});
    })();