extends layout

block head
  link(rel="stylesheet", href="/public/style.css")
  style.
    html, body { background: #000; color: #d1d5db; margin: 0; padding: 0; height: 100%; }
    * { font-family: 'Hack', 'SFMono-Regular', Consolas, monospace; }
    .landing-overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(0,0,0,0.6); }
    .auth-card { width: 100%; max-width: 400px; background: #0a0a0a; border: 1px solid #222; padding: 2.5rem; }
    .auth-heading { text-align: center; font-size: 16px; font-weight: 700; color: #d1d5db; margin: 0 0 4px; }
    .auth-sub { text-align: center; font-size: 12px; color: #525252; margin: 0 0 1rem; line-height: 1.5; }
    .auth-nick { text-align: center; font-size: 13px; color: #d1d5db; margin: 0 0 1.5rem; padding: 8px 10px; background: #111; border: 1px solid #222; }
    .auth-error { display: flex; gap: 6px; padding: 8px 10px; margin-bottom: 16px; background: rgba(248,113,113,0.08); border: 1px solid rgba(248,113,113,0.2); color: #f87171; font-size: 11px; line-height: 1.4; }
    .auth-form { display: flex; flex-direction: column; gap: 14px; }
    .auth-field { display: flex; flex-direction: column; gap: 6px; }
    .auth-field label { font-size: 11px; font-weight: 600; color: #8b949e; }
    .auth-field input { width: 100%; padding: 10px 12px; background: #000; border: 1px solid #222; color: #d1d5db; font-size: 13px; box-sizing: border-box; }
    .auth-button { width: 100%; padding: 10px 16px; margin-top: 6px; background: #3291ff; color: #fff; border: none; font-size: 13px; font-weight: 700; cursor: pointer; }

block body
  .landing-overlay
    .auth-card
      h1.auth-heading Finish your invite
      p.auth-sub An operator invited you to IRC Fiber
      .auth-nick This invite is locked to nick <strong>#{nick}</strong>

      - if (authError.length > 0)
        .auth-error(role="alert") #{authError}

      form.auth-form(method="POST", action="/invite", autocomplete="on", novalidate)
        input(type="hidden", name="token", value=token)
        .auth-field
          label(for="email") Email
          input#email(type="email", name="email", placeholder="you@example.com", required, autocomplete="email", spellcheck="false")
        .auth-field
          label(for="password") Password
          input#password(type="password", name="password", placeholder="at least 8 characters", required, autocomplete="new-password", minlength="8")
        button.auth-button(type="submit") Create account
