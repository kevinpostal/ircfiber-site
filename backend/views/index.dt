extends layout

block head
  style.
    /* IRCCloud-style pre-rendered spinner — visible until the SPA mounts */
    html, body, #app { height: 100dvh; margin: 0; padding: 0; background: #0d1117; }
    .initial-loader {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; height: 100dvh; gap: 16px;
      color: #8b949e; font-family: "Source Sans Pro", -apple-system, sans-serif;
      transition: opacity 0.2s ease-out;
    }
    .initial-loader__spinner {
      width: 32px; height: 32px; border: 3px solid #30363d;
      border-top-color: #58a6ff; border-radius: 50%;
      animation: initial-spin 0.8s linear infinite;
    }
    @keyframes initial-spin { to { transform: rotate(360deg); } }
    .initial-loader__text { font-size: 13px; letter-spacing: 0.02em; }

block body
  div#app
    div.initial-loader
      div.initial-loader__spinner
      div.initial-loader__text Connecting...

block scripts
  // Preload the critical CSS/JS so the browser can start fetching before parsing
  link(rel="preload", href="/public/dist/assets/main-DB1tHdpP.css", as="style")
  link(rel="stylesheet", href="/public/dist/assets/main-DB1tHdpP.css")
  link(rel="preload", href="/public/dist/assets/chunk-upload-BWnrPV3r.css", as="style")
  link(rel="stylesheet", href="/public/dist/assets/chunk-upload-BWnrPV3r.css")
