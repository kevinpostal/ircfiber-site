  link(rel="stylesheet", href="/public/dist/assets/vendor-Bil6o97j.css")
  link(rel="preload", href="/public/dist/assets/chunk-panels-CocnmuN3.css", as="style")
  link(rel="stylesheet", href="/public/dist/assets/chunk-panels-CocnmuN3.css")
