doctype html
html
  head
    block head
    title IRC Fiber
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="theme-color", content="#0e131a")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="anonymous")
    link(rel="preconnect", href="https://cdn.jsdelivr.net", crossorigin="anonymous")
    link(rel="preconnect", href="https://cdnjs.cloudflare.com", crossorigin="anonymous")
    // Preload the critical CSS so it doesn't block rendering as long
    link(rel="preload", href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap", as="style")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap", rel="stylesheet")
    // Hack font: async load via print-media swap to avoid render-blocking
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/hack-font@3/build/web/hack.css", media="print", onload="this.media='all'")
    noscript
      link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/hack-font@3/build/web/hack.css")
    // Font Awesome: async (icons are progressive enhancement, not critical for LCP)
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css", media="print", onload="this.media='all'")
    noscript
      link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
  body
    block body
    block scripts
