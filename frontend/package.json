{
  "name": "ircfiber-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "dev:tailnet": "VITE_BACKEND_URL=http://127.0.0.1:18090 vite",
    "build": "vite build && node inject-manifest.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:lib": "vitest run --project=lib",
    "test:client": "vitest run --project=client",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "esrap": "^2.2.12",
    "layerchart": "^1.0.13",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.60.0",
    "sass": "^1.101.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "axobject-query": "^4.1.0",
    "emoji-picker-element": "^1.29.1",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "jpeg-js": "^0.4.4",
    "svelte-dnd-action": "^0.9.55",
    "svelte-highlight": "^7.16.2"
  }
}
