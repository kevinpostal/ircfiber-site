# {{ ansible_managed }}
# IRC Fiber — gateway env file
# The gateway reaches Mongo & Redis via the Tailscale IP of the host they
# live on. The engine(s) do the same, pointing at the backend host's IP.

# SECRETS ARE NOT RENDERED HERE. `docker inspect ircfiber-gateway` prints
# every env var in cleartext, and so does Ansible output and any bug report
# that pastes an inspect — on 2026-09-06 that exposed the Mongo application
# password, the IRCd oper password, the SigNoz API key and the support bot's
# NickServ password to anyone who could reach the docker socket. Each of
# those now lives in a root-only 0400 file written by tasks/secrets.yml and
# bind-mounted read-only into the containers; only the *path* is in the env.
# The backend resolves `<VAR>_FILE` in preference to `<VAR>`
# (ircfiber.env.envSecret), so the file wins on a half-migrated host.
#
# Redis: the D library can't pass a password to connectRedis(); we rely
# on Tailscale network isolation (the redis container is bound only to
# the host's tailscale0 interface) instead of an in-protocol password.
# This URL therefore carries no credential and stays inline.
IRCFIBER_REDIS_URL=redis://{{ backend_tailscale_ip | default(host_tailscale_ip | default('127.0.0.1')) }}:{{ redis_port }}/0
# Mongo connection string incl. the application password — value rendered by
# tasks/secrets.yml (which also documents the URL-encoding and the
# `lastIndexOf("/")` database-name caveat that governs its shape).
IRCFIBER_MONGO_URL_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/mongo_url

# Session JWT HMAC key (ircfiber.api.session). REQUIRED: with no value the
# backend signs sessions with a random per-process key, so every session dies
# on restart. Before 2026-09-06 nothing rendered this at all and the fallback
# was a literal committed to a public repo — every production token was
# forgeable. Rotating the file logs everyone out exactly once.
IRCFIBER_JWT_SECRET_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/jwt_secret
{% if mullvad_sidecars is defined and mullvad_sidecars | length > 0 %}
# `<name>@host:port` — the name is the egress label shown in the "Connect via" picker.
# The blank line after the value is load-bearing: trim_blocks eats the newline
# after {% raw %}{% endfor %}{% endraw %}, which glued the next key onto this value on 2026-09-04.
IRCFIBER_MULLVAD_POOL={% for sc in mullvad_sidecars %}socks5://{{ sc.name }}@{{ sc.host | default('tailscale-mullvad-' ~ sc.name) }}:{{ sc.port | default(1080) }}{% if not loop.last %},{% endif %}{% endfor %}

{% endif %}
IRCFIBER_CONFIG_PATH=/config/prod.conf
# An admin-password-reset variable (vault_ircfiber_admin_password, via
# ircfiber_admin_password_reset) was rendered here until 2026-09-06. The
# backend never read it — no reference anywhere in site/backend/source — so
# it was a cleartext password sitting in the container env buying nothing.
# Do not reintroduce it: admin password resets go through the admin Users
# page.
{% if IRCFIBER_OTEL_ENABLED is defined %}
IRCFIBER_OTEL_ENABLED={{ IRCFIBER_OTEL_ENABLED }}
{% endif %}
{% if IRCFIBER_OTEL_ENDPOINT is defined %}
IRCFIBER_OTEL_ENDPOINT={{ IRCFIBER_OTEL_ENDPOINT }}
{% endif %}
{% if OTEL_RESOURCE_ATTRIBUTES is defined %}
OTEL_RESOURCE_ATTRIBUTES={{ OTEL_RESOURCE_ATTRIBUTES }}
{% endif %}
{% if bnc_enabled | default(false) | bool %}
# Bouncer endpoint advertised by the REST dialog (all gateways). Only the
# ircfiber-bnc container additionally gets IRCFIBER_BNC_PORT/TLS_* and listens.
IRCFIBER_BNC_PUBLIC_HOST={{ bnc_public_host }}
IRCFIBER_BNC_PUBLIC_PORT={{ bnc_public_port }}
IRCFIBER_BNC_PUBLIC_TLS=1
# BNC protocol trace for drop diagnosis (PASS redacted). High volume —
# enable via bnc_trace=true, gather logs, then redeploy with false.
IRCFIBER_BNC_TRACE={{ (bnc_trace | default(false) | bool) | ternary('1', '0') }}
{% endif %}

# SigNoz query API for the admin Logs page (gateway-side proxy in
# ircfiber.web.admin.logs). The API key is a k8s-SigNoz service-account
# key (vault_signoz_api_key) and is written to a file by tasks/secrets.yml;
# when no key has been minted the file is absent and the Logs page reports
# 401 with remediation steps.
IRCFIBER_SIGNOZ_URL={{ signoz_query_url | default('https://signoz.ubuntu-docker.tail544547.ts.net') }}
IRCFIBER_SIGNOZ_HOST={{ signoz_query_host | default('') }}
IRCFIBER_SIGNOZ_API_KEY_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/signoz_api_key
IRCFIBER_SIGNOZ_INSECURE={{ (signoz_insecure_tls | default(false) | bool) | ternary('1', '0') }}

# IRCd control session for the admin dashboard (ircfiber.web.admin.ircd).
# The gateway opens a short-lived TLS IRC connection to the InspIRCd
# container on the shared Docker network and OPERs as the least-privilege
# "dashboard" oper. IRCFIBER_IRCD_CONF_DIR is mounted read-only from the
# host (see gateway volumes) for the redacted config viewer.
IRCFIBER_IRCD_HOST={{ ircd_ircfiber_net_alias | default('ircd') }}
IRCFIBER_IRCD_PORT={{ ircd_port_tls | default(6697) }}
IRCFIBER_IRCD_TLS=1
IRCFIBER_IRCD_OPER={{ ircd_dashboard_oper_name | default('dashboard') }}
# Oper password (vault_ircd_dashboard_password) — file-rendered by
# tasks/secrets.yml; an env var here would hand ircd oper rights to
# anybody who can run `docker inspect`.
IRCFIBER_IRCD_OPER_PASSWORD_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/ircd_oper_password
IRCFIBER_IRCD_CONF_DIR={{ ircd_conf_dir | default('/etc/ircfiber/ircd') }}

# Anope XML-RPC endpoint (ircfiber.services.anope). The gateway registers
# each website account with NickServ through it and stores the generated
# password as the user's SASL credential on the IRC Fiber network. Empty
# disables auto-registration entirely.
IRCFIBER_ANOPE_RPC_URL={{ ('http://' ~ (ircd_services_net_alias | default('services')) ~ ':' ~ (ircd_services_rpc_port | default(8080)) ~ '/xmlrpc') if (ircd_services_rpc_enabled | default(true) | bool) else '' }}
IRCFIBER_ANOPE_RPC_TIMEOUT={{ ircd_services_rpc_timeout | default(10) }}
# Signup-time nick availability gate: reject a signup whose username is
# already registered (or is a service bot) on our IRC network, since the
# username is also the user's IRC nick and NickServ account. Fails open when
# Anope is unreachable. Set 0 to accept such signups and let
# ircfiber.services.accounts fall back to a derived nick instead.
IRCFIBER_SIGNUP_NICK_CHECK={{ (ircd_signup_nick_check | default(true) | bool) | ternary('1', '0') }}

# NickServ account the gateway runs privileged NickServ commands as for the
# admin NickServ section (ircfiber.web.admin.nickserv). It must be named in an
# Anope `oper {}` block AND registered with NickServ before services start —
# Anope logs "Tied oper <account> to type <opertype>" when that worked.
# `require_oper = yes` on the block does not matter here: an offline XML-RPC
# source resolves privileges straight from the opertype (CommandSource::HasPriv).
# Empty disables every privileged action; lookups keep working.
IRCFIBER_ANOPE_OPER_ACCOUNT={{ ircd_services_root_account | default(ircd_oper_name | default('admin')) }}
# Anope's flatfile database, bind-mounted read-only below. Backs the admin
# NickServ account inventory (Anope 2.0 has no enumeration RPC and LIST is
# capped at listmax). Empty or missing → the inventory degrades to IRC Fiber
# accounts from Mongo and the UI says why.
IRCFIBER_ANOPE_DB_PATH={{ '/var/lib/ircfiber/anope/anope.db' if (ircd_services_rpc_enabled | default(true) | bool) else '' }}

# NickServ password of the #support bot nick (vault_support_bot_nickserv_password),
# used only by the ircfiber-support-bot container (ircfiber.support.bot). It is
# rendered here as a path for every container because the support bot inherits
# this env file wholesale; the value itself is written by tasks/secrets.yml.
# The plaintext must NOT be re-added to the support-bot container's `env:`
# combine() in tasks/main.yml — that is exactly what `docker inspect
# ircfiber-support-bot` used to leak.
IRCFIBER_SUPPORT_BOT_NICKSERV_PASSWORD_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/support_bot_nickserv_password

# k3s API on ubuntu-docker over the tailnet. Backs the admin Backups page
# (GET /api/admin/backups): CronJob state, manual runs, suspend/resume and
# pod logs for ircfiber-prod's ircfiber-mongo-backup / ircfiber-redis-backup.
# The token is a namespaced ServiceAccount token with no delete verb
# (deploy/k8s/ircfiber-prod/rbac-backup-admin.yaml). Empty token file ->
# the page still shows published run history and says control is unavailable.
# INSECURE=1 for the same reason as SigNoz above: no MagicDNS in the
# container, so the URL is an IP literal against a k3s-CA-signed cert;
# the tailnet hop is WireGuard-encrypted.
IRCFIBER_K8S_API_URL={{ k3s_api_url }}
IRCFIBER_K8S_NAMESPACE=ircfiber-prod
IRCFIBER_K8S_TOKEN_FILE={{ gateway_secrets_dir | default('/etc/ircfiber/gateway/secrets') }}/k3s_backup_token
IRCFIBER_K8S_INSECURE=1
