/*
 * {{ ansible_managed }}
 * Anope 2.1 services — {{ ircd_services_name }} for {{ ircd_network_name }}
 *
 * The one services instance of the network: accounts, channels, BotServ,
 * OperServ and BridgeServ (the Discord bridge) all live in this process.
 * The image is our own build of Anope 2.1 with the bridgeserv module
 * (roles/ircd/files/Containerfile.anope).
 *
 * Mounted at /anope/conf/services.conf. The *.example.conf includes ship
 * with the image in the same directory; nickserv.conf, operserv.conf and
 * global.conf are our own (rendered) copies because Anope takes the first
 * module block by name, so example values cannot be overridden after an
 * include, and because duplicate service {} blocks are NOT deduped (a
 * second `service { nick = "Global" }` crashes Anope with SIGSEGV on start,
 * confirmed live 2026-09-11).
 *
 * Rendered twice by roles/ircd/tasks/services.yml:
 *   services.conf          the running configuration (ircd_services_db_migrate
 *                          undefined/false)
 *   services.migrate.conf  ircd_services_db_migrate = true: the one-shot
 *                          importer of the 2.0 anope.db. It loads the
 *                          load-only db_flatfile BEFORE db_json, and carries
 *                          no listener and no bridge — it exists only to be
 *                          started, reach "Databases loaded", and be stopped
 *                          so that db_json writes anope.json on shutdown.
 */
{% set db_migrate = ircd_services_db_migrate | default(false) | bool %}

define
{
	name = "services.host"
	value = "{{ ircd_services_name }}"
}

define
{
	name = "services.name"
	value = "{{ ircd_services_name }}"
}

/* Uplink: InspIRCd container via its Docker network alias. `protocol` is
 * the 2.1 spelling of 2.0's `ipv6 = no`. */
uplink
{
	host = "{{ ircd_ircfiber_net_alias }}"
	protocol = "ipv4"
	ssl = no
	port = {{ ircd_link_port }}
	password = "{{ vault_ircd_services_link_password }}"
}

/*
 * The SID is explicit and MUST differ from every other SID on the network
 * ({{ ircd_server_id }} is the ircd). Anope allocates the SIDs of BridgeServ's
 * per-guild virtual links by incrementing from this one ({{ ircd_services_server_id }} → next
 * letters), so leave room after it.
 */
serverinfo
{
	/* ${define} is the 2.1 reference syntax; a bare `services.name` is a
	 * literal server name in 2.1 and the ircd refuses the link. */
	name = "${services.name}"
	description = "{{ ircd_services_description }}"
	id = "{{ ircd_services_server_id }}"
	pid = "/tmp/services.pid"
	motd = "conf/services.motd"
}

/* Protocol: 2.1's native InspIRCd 4 module (2.0's `inspircd3` is gone). */
module { name = "inspircd" }

networkinfo
{
	networkname = "{{ ircd_network_name }}"
	nicklen = {{ ircd_nicklen }}
	userlen = {{ ircd_identlen }}
	hostlen = 64
	chanlen = {{ ircd_channellen }}
	modelistsize = 100
	vhost_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"
	allow_undotted_vhosts = false
	disallow_start_or_end = ".-"
}

options
{
	/* Must match the ircd codepage (modules.conf ships rfc1459 to match
	 * irc.netcrave.chat). ascii here + rfc1459 there = CAPAB "casemapping
	 * differs" and services flap forever. Anope ships both casemaps. */
	casemap = "rfc1459"
	badpasslimit = 5
	badpasstimeout = 1h
	updatetimeout = 5m
	expiretimeout = 30m
	readtimeout = 5s
	timeoutcheck = 3s
	retrywait = 30s
	hideprivilegedcommands = yes
	/* Show every registered command in HELP, not just the ones the caller
	 * currently has access to — a newcomer asking `/msg ChanServ HELP`
	 * should see what the service can do, not a list trimmed to nothing. */
	hideregisteredcommands = no
	/* No `languages`: the image ships no compiled catalogs, so every listed
	 * locale only logs "Unable to use language" at start. English only. */
}

/* Pseudo-clients. */

/*
 * Like os_session below, this MUST precede its example include — Anope
 * keeps the first module block by a given name. Every value matches
 * chanserv.example.conf except `defaults`, which drops cs_secure: with it,
 * a channel's access list only counts users who are identified to
 * NickServ. Note this applies to newly registered channels only; existing
 * ones keep whatever they were registered with (ircd_channel_setup.py
 * turns SECURE off explicitly on the staff channels).
 */
module
{
	name = "chanserv"
	client = "ChanServ"
	defaults = "keeptopic peace securefounder signkick"
	maxregistered = 20
	accessmax = 1024
	inhabit = 15s
	reasonmax = 200
	signkickformat = "%m (%n)"
	disallow_hostmask_access = no
	disallow_channel_access = no
	always_lower_ts = no
}
include { type = "file"; name = "chanserv.example.conf" }

/*
 * Same first-block-wins override as chanserv above. Every value matches
 * botserv.example.conf except `minusers`: at the example's 1, an assigned
 * bot parts as soon as the channel empties and rejoins when someone
 * arrives. At 0 it "will not part unless specifically unassigned, and
 * will keep the channel open" — which is what we want for channels that
 * are permanent anyway (+P), and stops the bot flapping in and out of a
 * quiet channel.
 *
 * Loading BotServ creates no bots, and bs_autoassign ships commented
 * out. The role's channel setup script runs `BOT ADD` and `ASSIGN`
 * instead (ircd_services_bot plus `bot: true` on a channel in
 * ircd_permanent_channels), so the bot list is deploy state rather than
 * something an oper typed once.
 */
module
{
	name = "botserv"
	client = "BotServ"
	defaults = "greet fantasy"
	minusers = 0
	botmodes = "ao"
}

/*
 * The fantasy prefix lives in its own module block, so it needs its own
 * override ahead of the same include. The directive is a *set* of
 * characters, any one of which starts a fantasy command; the example's
 * commented-out "!." would accept both `!kick` and `.kick`, and leaving
 * it out defaults to "!".
 *
 * A backtick keeps fantasy commands clear of the two prefixes that
 * already mean something here: `!` is what the IRC Fiber support bot
 * answers to in #support, and `.` opens a sentence often enough to
 * misfire.
 */
module
{
	name = "fantasy"
	fantasycharacter = "`"
}
include { type = "file"; name = "botserv.example.conf" }
include { type = "file"; name = "global.conf" }
include { type = "file"; name = "hostserv.example.conf" }
include { type = "file"; name = "memoserv.example.conf" }
include { type = "file"; name = "nickserv.conf" }

/*
 * os_session MUST be declared before operserv.conf (first block by name
 * wins). Every IRC Fiber user reaches this network through the engine
 * containers, so all of them share one or two source IPs; the example's
 * defaultsessionlimit = 5 made OperServ kill every 6th user right after
 * RPL_WELCOME ("Session limit exceeded", 2026-09-02). 0 = unlimited.
 */
module
{
	name = "os_session"
	defaultsessionlimit = 0
	maxsessionlimit = 100000
	exceptionexpiry = 1d
	sessionlimitexceeded = "The session limit for your IP %IP% has been exceeded."
	sessionlimitdetailsloc = "Please contact staff on #ircfiber."
}

/*
 * os_defcon — network-wide emergency restrictions, ships commented out in
 * operserv.example.conf. Declared here so the module actually loads;
 * defaultlevel 5 is normal operation, so nothing changes until an oper
 * runs `OperServ DEFCON <1-4>`.
 *
 * The level lists are the example's, minus `reducedsessions`. That
 * operation clamps every IP to <sessionlimit> concurrent clients, and on
 * this network every platform user arrives through a couple of engine
 * container IPs — the exact shape that made OperServ kill every 6th user
 * in the incident recorded above. Any limit low enough to blunt an attack
 * would disconnect our own users first, so the operation is structurally
 * wrong here rather than merely mistuned.
 *
 * Two consequences of the levels that are kept are worth knowing before
 * reaching for them: `forcechanmodes` sets +R on every channel, which
 * locks out platform users who have no NickServ account, and level 1's
 * `akillnewclients` will AKILL the engine IPs themselves — taking the
 * platform down for akillexpire even after DefCon is lifted. Both are the
 * intended shape of a "we are under attack" switch; `timeout` is enabled
 * so a forgotten level reverts itself rather than becoming an outage.
 */
module
{
	name = "os_defcon"
	defaultlevel = 5
	level4 = "nonewchannels nonewnicks nomlockchanges"
	level3 = "nonewchannels nonewnicks nomlockchanges forcechanmodes"
	level2 = "nonewchannels nonewnicks nomlockchanges forcechanmodes silentoperonly"
	level1 = "nonewchannels nonewnicks nomlockchanges forcechanmodes silentoperonly akillnewclients"
	chanmodes = "+R"
	akillexpire = 5m
	timeout = 15m
	globalondefcon = yes
	akillreason = "{{ ircd_network_name }} is not accepting new connections right now, please try again later."
}
command { service = "OperServ"; name = "DEFCON"; command = "operserv/defcon"; permission = "operserv/defcon"; }
include { type = "file"; name = "operserv.conf" }
{% if ircd_bridgeserv_enabled and not db_migrate %}

/*
 * BridgeServ — the Discord <-> IRC relay (modules/bridgeserv in our fork).
 * Every member of a bridged guild is introduced as an IRC pseudo client
 * under "<guild-id>.{{ ircd_bridgeserv_domain }}", a virtual server linked
 * behind this one. The stored bridges (`BridgeServ ADD`) live in
 * bridgeserv.module.json on the data volume (db_json's module_database).
 */
service
{
	nick = "BridgeServ"
	user = "services"
	host = "${services.host}"
	real = "Bridge Service"
}

module
{
	name = "bridgeserv"
	client = "BridgeServ"
	token = "{{ vault_bridgeserv_discord_token }}"
	protocol = "discord"
	domain = "{{ ircd_bridgeserv_domain }}"
	bridgename = "IRC Bridge"
	webhooksuffix = " (IRC)"
	/* Keep useridle 0: every guild member is introduced and joined when the
	 * bridge connects so #dmz shows the same population as Discord; a
	 * reaper would quit exactly the people that roster is there to show.
	 * Absence is expressed with IRC AWAY (usepresence), not by quitting. */
	useridle = {{ ircd_bridgeserv_user_idle }}
	/* usepresence needs PRESENCE INTENT enabled on the Discord application
	 * first (Bot -> Privileged Gateway Intents), or Discord closes the
	 * gateway with 4014 and nothing relays. SERVER MEMBERS INTENT is always
	 * required for the member roster. */
	usepresence = {{ ircd_bridgeserv_use_presence | ternary('yes', 'no') }}
	maxlines = 8
	floodlines = 6
	floodsecs = 4s
	relaytyping = yes
	relayreactions = yes
	/* An IRC "@nick" naming one of this bridge's Discord pseudo clients is
	 * relayed as a real Discord mention. Only the ids actually resolved end
	 * up in allowed_mentions; @everyone and roles never ping. */
	relaymentions = yes
	relayevents = "nick,topic,kick"
}

/* `permission` stays on every command, mutating ones included: without it
 * DEL and SET would be reachable by the whole network. Services Root and
 * Services Administrator hold bridgeserv/* (see the opertypes below); the
 * gateway's admin panel drives these as the Services Root account over
 * the JSON-RPC listener. */
command { service = "BridgeServ"; name = "HELP";     command = "generic/help" }
command { service = "BridgeServ"; name = "ADD";      command = "bridgeserv/add";      permission = "bridgeserv/add" }
command { service = "BridgeServ"; name = "SET";      command = "bridgeserv/set";      permission = "bridgeserv/set" }
command { service = "BridgeServ"; name = "DEL";      command = "bridgeserv/del";      permission = "bridgeserv/del" }
command { service = "BridgeServ"; name = "LIST";     command = "bridgeserv/list";     permission = "bridgeserv/list" }
command { service = "BridgeServ"; name = "STATUS";   command = "bridgeserv/status";   permission = "bridgeserv/status" }
command { service = "BridgeServ"; name = "GUILDS";   command = "bridgeserv/guilds";   permission = "bridgeserv/guilds" }
command { service = "BridgeServ"; name = "CHANNELS"; command = "bridgeserv/channels"; permission = "bridgeserv/channels" }
{% endif %}

/* Logging: services.log under /anope/logs plus globops for admin actions.
 * The file target also feeds #staff so opers see the whole services log in
 * the channel without needing +s snomasks, and can answer with `/msg
 * OperServ DEFCON <1-4>` from the same window (Anope splits `target` on
 * whitespace: file names, `globops` and channel names may be mixed in one
 * block). #staff is oper-only (+O, mode-locked), so per the Anope "secure
 * your log channels" rule no additional securing is needed. Note the
 * channel also carries users=connect/disconnect, which is chatty: every
 * platform user arrives through a couple of engine container IPs.
 * bot = Global matters only as a fallback: Anope's LOG_ADMIN (admin=)
 * and LOG_USER (users=) categories always carry a predefined sender —
 * the command's owning service — which overrides `bot =` entirely
 * (src/logger.cpp Log::ProcessMessage: `bi = l->bi; if (!bi) bi =
 * this->bot;`). Channel delivery is a raw PRIVMSG from that sender, and
 * InspIRCd's +n (noextmsg) on #staff silently drops it unless the sender
 * is actually a channel member — so BOTH Global (bot fallback) and
 * OperServ (predefined sender for the admin/user categories) need
 * `channels = "#staff"` in their own service {} blocks. See
 * global.conf.j2 and operserv.conf.j2 for why that means owning those
 * files outright rather than adding override blocks. */
log
{
	target = "services.log #staff"
	bot = "Global"
	logage = 7
	admin = "*"
	override = "chanserv/* nickserv/* memoserv/set ~botserv/set botserv/*"
	commands = "~operserv/* *"
	servers = "*"
	users = "connect disconnect nick"
	other = "*"
	rawio = no
	debug = no
}

log
{
	target = "globops"
	admin = "global/* operserv/chankill operserv/mode operserv/kick operserv/akill operserv/s*line operserv/noop operserv/jupe operserv/oline operserv/set operserv/svsnick operserv/svsjoin operserv/svspart nickserv/getpass */drop"
	servers = "squit"
	users = "oper"
	other = "expire/* bados akill/*"
}

/* Oper access */
opertype
{
	name = "Helper"
	commands = "hostserv/*"
}

opertype
{
	name = "Services Operator"
	inherits = "Helper"
	commands = "chanserv/list chanserv/suspend chanserv/topic memoserv/staff nickserv/list nickserv/suspend operserv/mode operserv/chankill operserv/akill operserv/session operserv/modinfo operserv/sqline operserv/oper operserv/kick operserv/ignore operserv/snline"
	privs = "chanserv/auspex chanserv/no-register-limit memoserv/* nickserv/auspex nickserv/confirm"
}

/* bridgeserv/* sits here and not lower: managing the Discord bridge is a
 * network-administration act (it introduces and quits pseudo clients),
 * not something a helper or channel operator does. */
opertype
{
	name = "Services Administrator"
	inherits = "Services Operator"
	commands = "botserv/* chanserv/access/list chanserv/drop chanserv/getkey chanserv/saset/noexpire memoserv/sendall nickserv/saset/* nickserv/getemail operserv/news operserv/jupe operserv/svs operserv/stats operserv/oline operserv/noop operserv/forbid global/* bridgeserv/*"
	privs = "*"
}

opertype
{
	name = "Services Root"
	commands = "*"
	privs = "*"
}

/*
 * The IRCd oper account doubles as Services Root: register the nick
 * "{{ ircd_oper_name }}" with NickServ, identify, then /OPER on the IRCd.
 */
oper
{
	name = "{{ ircd_oper_name }}"
	type = "Services Root"
	require_oper = yes
}
{% for account in ircd_services_root_extra_accounts %}

/*
 * Additional Services Root. `require_oper = yes` means the account only
 * gains these privileges while its owner is also opered on the IRCd, so
 * they still need the <oper> credentials in opers.conf — the NickServ
 * account name and the /OPER name are independent.
 */
oper
{
	name = "{{ account }}"
	type = "Services Root"
	require_oper = yes
}
{% endfor %}

/* No mailer in the container: registration does not require email confirmation. */
mail
{
	usemail = no
	sendmailpath = "/usr/sbin/sendmail -t"
	sendfrom = "{{ ircd_admins[0].email }}"
	delay = 5m
}
{% if db_migrate %}

/*
 * MIGRATION ONLY. db_flatfile can only load in 2.1, and OnLoadDatabase
 * stops at the first module that answers — so it must precede db_json
 * here, and it must be absent from the running services.conf: with both
 * present every restart would reload the stale 2.0 anope.db over the live
 * json. Anope refuses to start with only a deprecated database module,
 * which is why db_json follows.
 */
module
{
	name = "db_flatfile"
	database = "anope.db"
}
{% endif %}

/* Database: db_json on the data volume, which the role mounts directly at
 * /anope/data. Module-owned data (BridgeServ's bridges) goes to
 * <module>.module.json next to it. Anope keeps its own rolling backups
 * under backups/; the one-shot 2.0 snapshot the migration takes lives on
 * the host under /var/backups/ircfiber. */
module
{
	name = "db_json"
	database = "anope.json"
	module_database = "{name}.module.json"
	daily_backups = 7
	monthly_backups = 3
	backup_directory = "backups"
}

/* Password hashing: bcrypt for new passwords. enc_sha256 is deprecated in
 * 2.1 but must stay loaded (second, never first): it still verifies the
 * legacy `sha256:` hashes 2.0 stored, and because it is not the primary
 * module a successful identify re-hashes the password with bcrypt. */
module { name = "enc_bcrypt" }
module { name = "enc_sha256" }
{% if ircd_services_rpc_enabled | default(true) | bool and not db_migrate %}

/*
 * JSON-RPC control surface. Container-internal only: ircfiber-services
 * publishes no ports, so only the docker network can reach it, and on top
 * of that every request must carry the Bearer token below. The gateway
 * uses it to run services commands on behalf of website accounts
 * (`anope.command`, including `NickServ REGISTER` as a nick that is not
 * yet registered — see rpc_user below), to verify credentials, and to
 * read the account/channel inventories for the admin dashboard.
 *
 * ip = "::" and not "0.0.0.0": Anope picks the socket family purely from
 * whether the address contains a colon and never sets IPV6_V6ONLY, so a
 * v4 bind refuses every AAAA-preferring client on a dual-stack docker
 * network while `::` accepts both (Linux net.ipv6.bindv6only=0).
 */
module
{
	name = "httpd"

	httpd
	{
		name = "httpd/main"
		ip = "{{ ircd_services_rpc_bind | default('::') }}"
		port = {{ ircd_services_rpc_port | default(8080) }}
		timeout = 30
		extforward_header = "X-Forwarded-For Forwarded-For"
	}
}

/*
 * The token's method list is the whole authorisation surface: exactly the
 * methods the gateway calls, nothing that identifies a live user
 * (anope.identify), messages the network (anope.message*) or enumerates
 * opers/servers. xmlrpc must not be loaded beside jsonrpc.
 */
module
{
	name = "jsonrpc"
	server = "httpd/main"

	token
	{
		token = "{{ vault_ircd_services_rpc_token }}"
		methods = "anope.command anope.checkCredentials anope.user anope.account anope.listAccounts anope.listRegisteredChannels anope.registeredChannel anope.listSuspendedAccounts"
	}
}

/*
 * pretenduser = no keeps anope.command running as the bare account rather
 * than as the session of an online IRC user. allowunregistered = yes is
 * our patch (files/anope-rpc-command-unregistered.patch): a command whose
 * account is an unregistered nick runs as that nick with no account,
 * which is how the gateway registers a website user's nick offline —
 * `NickServ REGISTER` registers the nick the command came from.
 */
module
{
	name = "rpc_user"
	pretenduser = no
	allowunregistered = yes
}

/* anope.user / anope.account / anope.listAccounts. */
module { name = "rpc_data" }

/* anope.listRegisteredChannels / anope.registeredChannel /
 * anope.listSuspendedAccounts — files/anope-rpc-registered.patch. */
module { name = "rpc_registered" }
{% endif %}

/* Extras (help etc.). */
include { type = "file"; name = "modules.example.conf" }
