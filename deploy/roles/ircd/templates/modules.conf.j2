#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  TLS  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="ssl_gnutls">
<sslprofile name="main"
            provider="gnutls"
            cafile=""
{% if ircd_tls_mode == "letsencrypt" %}
            certfile="{{ ircd_tls_cert_file }}"
{% else %}
            certfile="cert.pem"
{% endif %}
            crlfile=""
            dhfile="dhparams.pem"
            hash="sha256"
{% if ircd_tls_mode == "letsencrypt" %}
            keyfile="{{ ircd_tls_key_file }}"
{% else %}
            keyfile="key.pem"
{% endif %}
            mindhbits="2048"
            outrecsize="2048"
            priority="NORMAL:-VERS-TLS1.0:-VERS-TLS1.1"
            requestclientcert="yes"
            strictpriority="no">
<module name="sslinfo">
<sslinfo hash="sha256" localsecure="no" operonly="no" welcomemsg="no">
<module name="sslmodes">

#-#-#-#-#-#-#-#-#-#-#-#  REVERSE PROXY (Tor ingress)  -#-#-#-#-#-#-#-#-#-#
#
# Accepts HAProxy PROXY-protocol connections for the tor listener in
# custom.conf. Inert until a proxy feeds it; VF_VENDOR + modeless so it
# can never disturb the netcrave server link.

<module name="haproxy">

# WEBIRC: the IRC Fiber engine sends `WEBIRC <password> ircfiber <ip> <ip>`
# on every connection to this network so the user's own browser address
# replaces the engine's docker address — connect class, cloak, connectban,
# FiberEye and the per-user MOTD all key on it. Authorised by source mask
# (the engine dials from the docker network) plus the hashed
# vault_ircd_webirc_password (password_hash + sha2 above make hmac-sha256
# verifiable). The <connect name="ircfiber-web" webirc="ircfiber"> class in
# inspircd.conf is matched the instant this module swaps the address, and
# is enforced by THIS module: unload it and that class would catch every
# native client (allow="*" ahead of main), so the two go together.
<module name="gateway">
<gateway type="webirc"
         mask="{{ ircd_trusted_subnet }} {{ ircd_trusted_subnet_v6 }}"
         password="{{ ircd_webirc_password_hash }}"
         hash="hmac-sha256">

#-#-#-#-#-#-#-#-#-#-#-#-#  SERVICES / SASL  -#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="spanningtree">

{% if not ircd_is_leaf %}
# Incoming link from Anope (container alias "{{ ircd_services_net_alias }}").
# Leaf servers omit this: the single Anope links to the hub only, and the
# leaf reaches it across the hub link (<services>/<sasl> below stay on).
<link name="{{ ircd_services_name }}"
      ipaddr="{{ ircd_services_net_alias }}"
      port="{{ ircd_link_port }}"
      allowmask="{{ ircd_trusted_subnet }}"
      hidden="no"
      sendpass="{{ vault_ircd_services_link_password }}"
      recvpass="{{ vault_ircd_services_link_password }}">
{% endif %}

<services server="{{ ircd_services_name }}" silent="yes">

<module name="sasl">
<sasl target="{{ ircd_services_name }}" requiressl="no">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  HOST CLOAKING  -#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="cloak">
<module name="cloak_sha256">
<cloak method="hmac-sha256-addr"
       key="{{ vault_ircd_cloak_key }}"
{% if ircd_cloak_prefix %}       prefix="{{ ircd_cloak_prefix }}"
{% endif %}       suffix="{{ ircd_cloak_suffix }}">
<module name="chghost">
<module name="chgident">
<module name="chgname">
<module name="sethost">
<module name="setident">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  CHANNELS  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="permchannels">
{% if not ircd_is_leaf %}
# Hub only. A leaf must not persist channels locally: on boot it would
# re-create them with a fresh TS before the netburst arrives, and the older
# hub TS would then wipe the local modes. The permchannels module above stays
# loaded on both sides regardless — chanmode +P is in the mode list CAPAB
# compares.
<permchanneldb filename="/inspircd/data/permchannels.conf"
               listmodes="yes"
               saveperiod="5s"
               operonly="yes">
<include file="/inspircd/data/permchannels.conf" missingokay="yes">
{% endif %}
# Seeds these channels on a fresh host only: permchanneldb writes the live
# modes back to /inspircd/data/permchannels.conf, which is <include>d above
# (i.e. before these tags) and LoadDatabase skips channels that already
# exist — so on an existing network the saved copy always wins, and it is
# the ChanServ mode lock that changes an existing channel, not this.
{% for ch in ircd_permanent_channels %}
<permchannels channel="{{ ch.channel }}" modes="{{ ch.modes | default('nt') }}P{% if ch.history is defined and ch.history %}H {{ ch.history }}{% endif %}" topic="{{ ch.topic | default('') }}">
{% endfor %}

{% if ircd_default_channels | length > 0 %}
<module name="conn_join">
<autojoin channel="{{ ircd_default_channels | join(',') }}">
{% endif %}

<module name="chanhistory">
<chanhistory maxlines="50" maxduration="1w" prefixmsg="yes">
<module name="autoop">
<module name="banexception">
<module name="blockcolor">
<module name="botmode">
<module name="inviteexception">
<module name="knock">
<module name="namedmodes">
<module name="remove">
<module name="silence">
<silence exemptuline="yes" maxentries="256">
<module name="noctcp">
<module name="nonotice">
<module name="opmoderated">
<module name="delayjoin">
# Required by Anope's inspircd3 protocol module.
<module name="hidechans">

#-#-#-#-#-#-#-#-#-#-#  FLOOD & ABUSE PROTECTION  -#-#-#-#-#-#-#-#-#-#-#-#
#
# Mode-driven (+f/+j/+F/+E) and class-scoped protections. The
# ircfiber-engine connect class sets useconnflood="no" + useconnectban="no"
# with no clone limits, so multiplexed platform users behind
# {{ ircd_trusted_subnet }} are never throttled here — these bite only
# direct public connections in the "main" class.

<module name="connflood">
# m_connflood is a SERVER-WIDE throttle, not a per-IP one: once it trips it
# refuses every new connection for `timeout`. It was loaded here with no
# <connflood> tag at all, so InspIRCd's defaults applied — verified on
# 4.11.0 as maxconns="3" per period="30", i.e. the 4th direct public
# connection in any 30 second window locked out the whole network. Two
# consequences, both measured: legitimate users were refused during any
# small burst, and because the refusal happens BEFORE registration the
# ircd emits no connect snotice, so FiberEye could not see those attempts
# at all — which made its own connect_flood threshold unreachable.
#
# 60 per 30 s is ~2/s sustained, far above anything organic on a network
# this size and far below a real mass-connect flood, and it leaves the
# per-IP-group judgement to <connectban> below and to FiberEye, which can
# both actually see the traffic. bootwait keeps it quiet while the ircd
# comes up and clients reconnect in a herd.
<connflood period="30"
           maxconns="60"
           timeout="30"
           bootwait="2m"
           quitmsg="The server is not accepting new connections right now. Please try again in a minute.">
<module name="connectban">
# The ircd's own first line of defence, retuned to actually fire: at the
# stock threshold="32" a client can reconnect 31 times per bootwait window
# and never trip, which is exactly how the observed connect flood sailed
# through. 8 connects in the window is well above anything a human client
# does and the ban is short (5m), so a flapping link self-heals.
# ipv6cidr="64" matches FiberEye's own grouping: the flood rotates
# addresses inside one /64, so banning a single /128 bans nothing.
#
# The key is `banduration`, NOT `duration`. InspIRCd 4 renamed it
# (examples/modules.example.conf: `banduration="6h"`), and an unknown
# attribute is ignored SILENTLY with no config warning — verified against
# 4.11.0, where `duration="300"` and `duration="5m"` both produced a
# 21600-second Z-line, i.e. the 6-hour default. A five-minute intent
# would have shipped as a six-hour ban on eight connects.
#
# The banmessage MUST keep starting with the literal `FiberEye:` — the
# backend predicate isAutoPlacedZline() keys on that prefix, and it is
# what lets the public /unban page lift a machine-placed Z-line while
# never touching one a human oper set by hand.
# Safe for our own infrastructure: the ircfiber-engine (inspircd.conf.j2:75),
# ircfiber-engine-v6 (:104), localhost (:145) and localhost-v6 (:166)
# connect classes all set useconnectban="no", which is what keeps the
# ircd's healthcheck from Z-lining the ircd's own source address.
<connectban banmessage="FiberEye: connection flood detected. Appeal: {{ ircd_appeal_url }}"
            banduration="5m"
            bootwait="128"
            ipv4cidr="32"
            ipv6cidr="64"
            splitwait="128"
            threshold="8">
<module name="messageflood">
<messageflood notice="1.0" privmsg="1.0" tagmsg="0.2">
<module name="joinflood">
<joinflood bootwait="32s" duration="32s" splitwait="32s">
<module name="nickflood">
<nickflood duration="64s">
<module name="repeat">
<repeat maxbacklog="20" maxdistance="50" maxlines="20" maxtime="0" size="512">
<module name="blockamsg">
<blockamsg action="killopers" delay="3">
<module name="shun">
<shun affectopers="no"
      allowconnect="no"
      allowtags="no"
      cleanedcommands="AWAY PART QUIT"
      enabledcommands="ADMIN OPER PING PONG QUIT PART JOIN"
      notifyuser="yes">
<module name="timedbans">
<timedbans sendnotice="yes">

# Server-side ignore (+g): lets users require /ACCEPT before strangers
# can message them. Off by default per user; no behavior change until set.
<module name="callerid">
<callerid cooldown="4m" maxaccepts="256" tracknick="yes">

{% if ircd_enable_dnsbl %}
# Opt-in DNSBL checks (off by default: adds connect latency and can false-
# positive on shared/CGNAT ranges). The engine class keeps usednsbl="no";
# enabling this flips the "main" class to usednsbl="yes".
<module name="dnsbl">
<dnsbl action="zline"
       domain="dnsbl.dronebl.org"
       duration="5m"
       name="DroneBL"
       reason="Listed in DroneBL"
       records="3,5,6,7,8,9,10,11,13,14,15,16,17,19"
       timeout="5s"
       type="record">
<dnsbl action="zline"
       domain="rbl.efnetrbl.org"
       duration="5m"
       name="EFnet RBL"
       reason="Listed in EFnet RBL"
       records="1,2,3,4,5"
       timeout="5s"
       type="record">
<dnsbl action="zline"
       domain="torexit.dan.me.uk"
       duration="5m"
       name="TorExit"
       reason="Tor exit relay"
       records="100"
       timeout="5s"
       type="record">
{% endif %}

