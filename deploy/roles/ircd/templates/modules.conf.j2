# {{ ansible_managed }}
# InspIRCd 4 modules — {{ ircd_server_name }}
# Reference: https://docs.inspircd.org/4/modules/

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  CORE-ISH  -#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="cap">
<module name="account">
# alias is loaded by &dir.example;/services/anope.example.conf
<module name="services">
<module name="password_hash">
<module name="sha2">
<module name="conn_umodes">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  IRCv3  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="ircv3">
<ircv3 accountnotify="yes"
       awaynotify="yes"
       extendedjoin="yes"
       noimplicitnames="yes"
       standardreplies="yes">
<module name="ircv3_accounttag">
<module name="ircv3_batch">
<module name="ircv3_capnotify">
<module name="ircv3_chghost">
<module name="ircv3_ctctags">
<module name="ircv3_echomessage">
<module name="ircv3_invitenotify">
<module name="ircv3_labeledresponse">
<module name="ircv3_msgid">
<module name="ircv3_servertime">
<module name="monitor">
<monitor maxentries="64">
<module name="multiprefix">
<module name="uhnames">
<module name="setname">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  TLS  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="ssl_gnutls">
<sslprofile name="main"
            provider="gnutls"
            cafile=""
{% if ircd_tls_mode == "letsencrypt" %}
            certfile="{{ ircd_tls_cert_file }}"
{% else %}
            certfile="cert.pem"
{% endif %}
            crlfile=""
            dhfile="dhparams.pem"
            hash="sha256"
{% if ircd_tls_mode == "letsencrypt" %}
            keyfile="{{ ircd_tls_key_file }}"
{% else %}
            keyfile="key.pem"
{% endif %}
            mindhbits="2048"
            outrecsize="2048"
            priority="NORMAL:-VERS-TLS1.0:-VERS-TLS1.1"
            requestclientcert="yes"
            strictpriority="no">
<module name="sslinfo">
<sslinfo hash="sha256" localsecure="no" operonly="no" welcomemsg="no">
<module name="sslmodes">

#-#-#-#-#-#-#-#-#-#-#-#  REVERSE PROXY (Tor ingress)  -#-#-#-#-#-#-#-#-#-#
#
# Accepts HAProxy PROXY-protocol connections for the tor listener in
# custom.conf. Inert until a proxy feeds it; VF_VENDOR + modeless so it
# can never disturb the netcrave server link.

<module name="haproxy">

#-#-#-#-#-#-#-#-#-#-#-#-#  SERVICES / SASL  -#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="spanningtree">

# Incoming link from Anope (container alias "{{ ircd_services_net_alias }}").
<link name="{{ ircd_services_name }}"
      ipaddr="{{ ircd_services_net_alias }}"
      port="{{ ircd_link_port }}"
      allowmask="{{ ircd_trusted_subnet }}"
      hidden="no"
      sendpass="{{ vault_ircd_services_link_password }}"
      recvpass="{{ vault_ircd_services_link_password }}">

<services server="{{ ircd_services_name }}" silent="yes">

<module name="sasl">
<sasl target="{{ ircd_services_name }}" requiressl="no">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  HOST CLOAKING  -#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="cloak">
<module name="cloak_sha256">
<cloak method="hmac-sha256-addr"
       key="{{ vault_ircd_cloak_key }}"
{% if ircd_cloak_prefix %}       prefix="{{ ircd_cloak_prefix }}"
{% endif %}       suffix="{{ ircd_cloak_suffix }}">
<module name="chghost">
<module name="chgident">
<module name="chgname">
<module name="sethost">
<module name="setident">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  CHANNELS  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="permchannels">
<permchanneldb filename="/inspircd/data/permchannels.conf"
               listmodes="yes"
               saveperiod="5s"
               operonly="yes">
<include file="/inspircd/data/permchannels.conf" missingokay="yes">
{% for ch in ircd_permanent_channels %}
<permchannels channel="{{ ch.channel }}" modes="{{ ch.modes | default('nt') }}P" topic="{{ ch.topic | default('') }}">
{% endfor %}

{% if ircd_default_channels | length > 0 %}
<module name="conn_join">
<autojoin channel="{{ ircd_default_channels | join(',') }}">
{% endif %}

<module name="chanhistory">
<chanhistory maxlines="50" maxduration="1w" prefixmsg="yes">
<module name="autoop">
<module name="banexception">
<module name="blockcolor">
<module name="botmode">
<module name="inviteexception">
<module name="knock">
<module name="namedmodes">
<module name="remove">
<module name="silence">
<silence exemptuline="yes" maxentries="256">
<module name="noctcp">
<module name="nonotice">
<module name="opmoderated">
<module name="delayjoin">
# Required by Anope's inspircd3 protocol module.
<module name="hidechans">

#-#-#-#-#-#-#-#-#-#-#  FLOOD & ABUSE PROTECTION  -#-#-#-#-#-#-#-#-#-#-#-#
#
# Mode-driven (+f/+j/+F/+E) and class-scoped protections. The
# ircfiber-engine connect class sets useconnflood="no" + useconnectban="no"
# with no clone limits, so multiplexed platform users behind
# {{ ircd_trusted_subnet }} are never throttled here — these bite only
# direct public connections in the "main" class.

<module name="connflood">
<module name="connectban">
<connectban banmessage="Filtered for connection hammering; wait 64 seconds to retry"
            bootwait="128"
            duration="64"
            ipv4cidr="32"
            ipv6cidr="128"
            splitwait="128"
            threshold="32">
<module name="messageflood">
<messageflood notice="1.0" privmsg="1.0" tagmsg="0.2">
<module name="joinflood">
<joinflood bootwait="32s" duration="32s" splitwait="32s">
<module name="nickflood">
<nickflood duration="64s">
<module name="repeat">
<repeat maxbacklog="20" maxdistance="50" maxlines="20" maxtime="0" size="512">
<module name="blockamsg">
<blockamsg action="killopers" delay="3">
<module name="shun">
<shun affectopers="no"
      allowconnect="no"
      allowtags="no"
      cleanedcommands="AWAY PART QUIT"
      enabledcommands="ADMIN OPER PING PONG QUIT PART JOIN"
      notifyuser="yes">
<module name="timedbans">
<timedbans sendnotice="yes">

# Server-side ignore (+g): lets users require /ACCEPT before strangers
# can message them. Off by default per user; no behavior change until set.
<module name="callerid">
<callerid cooldown="4m" maxaccepts="256" tracknick="yes">

{% if ircd_enable_dnsbl %}
# Opt-in DNSBL checks (off by default: adds connect latency and can false-
# positive on shared/CGNAT ranges). The engine class keeps usednsbl="no";
# enabling this flips the "main" class to usednsbl="yes".
<module name="dnsbl">
<dnsbl action="zline"
       domain="dnsbl.dronebl.org"
       duration="5m"
       name="DroneBL"
       reason="Listed in DroneBL"
       records="3,5,6,7,8,9,10,11,13,14,15,16,17,19"
       timeout="5s"
       type="record">
<dnsbl action="zline"
       domain="rbl.efnetrbl.org"
       duration="5m"
       name="EFnet RBL"
       reason="Listed in EFnet RBL"
       records="1,2,3,4,5"
       timeout="5s"
       type="record">
<dnsbl action="zline"
       domain="torexit.dan.me.uk"
       duration="5m"
       name="TorExit"
       reason="Tor exit relay"
       records="100"
       timeout="5s"
       type="record">
{% endif %}

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  OPER TOOLS  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<module name="opermodes">
<module name="check">
<module name="globops">
<module name="swhois">
<module name="tline">
<module name="cban">
<module name="clearchan">
<module name="sajoin">
<module name="sakick">
<module name="samode">
<module name="sanick">
<module name="sapart">
<module name="saquit">
<module name="satopic">
<module name="xline_db">

#-#-#-#-#-#-#-#-#-  SERVER LINK COMPAT (irc.netcrave.chat)  -#-#-#-#-#-#-#-#
# Spanningtree CAPAB refuses a link unless both sides agree on three
# things (src/modules/m_spanningtree/capab.cpp):
#   1. VF_COMMON modules + their link data (cloak, codepage, filter/rline
#      regex engine (pinned to glob below), repeat, kicknorejoin ...) —
#      always fatal.
#   2. The full channel-mode and user-mode lists — always fatal, so every
#      mode-providing module netcrave loads must be loaded here with the
#      same letters/prefixes/ranks (below, "MODE PARITY"), and every mode
#      they disable must be disabled here too (below, "DISABLED MODES").
#   3. VF_OPTCOMMON modules + extbans — fatal unless BOTH sides set
#      <options allowmismatch="yes"> (netcrave does; see inspircd.conf).
# Removing any of these (or changing cloak method) breaks the link.
# Verify with: send "CAPAB START 1206" to each server's :4445 (TLS) and
# diff the CAPAB MODULES/CHANMODES/USERMODES replies.

<module name="anticaps">
<module name="banredirect">
<module name="codepage">
# Stock rfc1459 tables, verbatim from the image's
# examples/codepages/rfc1459.example.conf — matches irc.netcrave.chat.
# Spanningtree CAPAB compares name + front/map/middle tables with linked
# servers; any difference refuses the link. Reports CASEMAPPING=rfc1459.
<codepage name="rfc1459">
<cpchars index="45">                        # -
<cpchars begin="48"  end="57">              # 01234567899
<cpchars begin="65"  end="90"  front="yes"> # ABCDEFGHIJKLMNOPQRSTUVWXYZ
<cpchars begin="91"  end="96"  front="yes"> # [\]^_`
<cpchars begin="97"  end="122" front="yes"> # abcdefghijklmnopqrstuvwxyz
<cpchars begin="123" end="125" front="yes"> # {|}
<cpcase lower="97"  upper="65"> # a => A
<cpcase lower="98"  upper="66"> # b => B
<cpcase lower="99"  upper="67"> # c => C
<cpcase lower="100" upper="68"> # d => D
<cpcase lower="101" upper="69"> # e => E
<cpcase lower="102" upper="70"> # f => F
<cpcase lower="103" upper="71"> # g => G
<cpcase lower="104" upper="72"> # h => H
<cpcase lower="105" upper="73"> # i => I
<cpcase lower="106" upper="74"> # j => J
<cpcase lower="107" upper="75"> # k => K
<cpcase lower="108" upper="76"> # l => L
<cpcase lower="109" upper="77"> # m => M
<cpcase lower="110" upper="78"> # n => N
<cpcase lower="111" upper="79"> # o => O
<cpcase lower="112" upper="80"> # p => P
<cpcase lower="113" upper="81"> # q => Q
<cpcase lower="114" upper="82"> # r => R
<cpcase lower="115" upper="83"> # s => S
<cpcase lower="116" upper="84"> # t => T
<cpcase lower="117" upper="85"> # u => U
<cpcase lower="118" upper="86"> # v => V
<cpcase lower="119" upper="87"> # w => W
<cpcase lower="120" upper="88"> # x => X
<cpcase lower="121" upper="89"> # y => Y
<cpcase lower="122" upper="90"> # z => Z
<cpcase lower="123" upper="91"> # { => [
<cpcase lower="124" upper="92"> # | => \
<cpcase lower="125" upper="93"> # } => ]
<cpcase lower="126" upper="94"> # ~ => ^
<module name="dccallow">
<module name="filter">
<module name="regex_glob">
# filter/rline link data includes the active regex engine name, so pin it
# to glob (v4 tag is <filteropts>; v3 called it <filter>). Netcrave loads
# glob+posix+stdlib with no engine override, which also resolves to glob.
<filteropts engine="glob">
<module name="globalload">
<module name="kicknorejoin">
<module name="rline">
# Engine name is link-compared (see above); the other two flags mirror
# irc.netcrave.chat's <rline> tag exactly.
<rline engine="glob"
       matchonnickchange="yes"
       zlineonmatch="no">

# DISABLED MODES — load-bearing for the link. CAPAB compares the channel-
# and user-mode lists UNCONDITIONALLY (allowmismatch does not cover them),
# and netcrave disables chanmode z (sslonly) + usermodes d/D (deaf/privdeaf)
# + z (sslqueries). We load sslmodes + deaf, so without this our lists are
# a superset of theirs and spanningtree refuses the link. Values mirror
# irc.netcrave.chat's <disabled> tag; v3 spelled fakenonexistant, v4 spells
# it fakenonexistent. Their empty commands="" is omitted (default: none).
<module name="disable">
<disabled chanmodes="z"
          fakenonexistent="no"
          usermodes="dDz">

# MODE PARITY — modules whose only CAPAB impact is the mode letter they
# register. Settings mirror netcrave's config so mode semantics (who may
# set what) are identical network-wide, not just the letters.

# Channel modes
<module name="customprefix">
<customprefix name="founder" letter="q" prefix="~" rank="50000" ranktoset="50000">
<customprefix name="admin" letter="a" prefix="&amp;" rank="40000" ranktoset="50000">
<customprefix name="halfop" letter="h" prefix="%" rank="20000" ranktoset="30000">
<customprefix name="op" change="yes" rank="30000" ranktoset="30000">
<customprefix name="voice" change="yes" depriv="no" rank="10000" ranktoset="20000">
<module name="operprefix">
<operprefix prefix="*">
<module name="ojoin">
<ojoin prefix="!" notice="yes" op="yes">
<module name="allowinvite">
<module name="auditorium">
<auditorium opcansee="no" opercansee="yes" opvisible="no">
<module name="chanfilter">
<chanfilter hidemask="yes" maxlen="250" notifyuser="yes">
<module name="delaymsg">
<delaymsg allownotice="yes">
<module name="exemptchanops">
<module name="nokicks">
<module name="nonicks">
<module name="operchans">
<module name="redirect">
<module name="stripcolor">

# User modes
# umode +c (deaf_commonchan): only users sharing a channel may PM you.
<module name="commonchans">
<module name="deaf">
<module name="helpmode">
<module name="hideoper">
<module name="override">
<override enableumode="yes" noisy="yes" requirekey="yes">
<module name="showwhois">
<showwhois opersonly="no" showfromopers="yes">
