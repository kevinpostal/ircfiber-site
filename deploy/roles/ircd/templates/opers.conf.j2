# {{ ansible_managed }}
# InspIRCd 4 oper classes/types/accounts — {{ ircd_server_name }}
# Reference: https://docs.inspircd.org/4/configuration/#oper

# The three users/flood/* privs are the only complete bypass of the
# penalty system, and each disables a different check in src/users.cpp:
#   no-fakelag         penaltymax = ULONG_MAX, so CommandFloodPenalty is
#                      never reached and the class's threshold stops
#                      applying at all
#   increased-buffers  skips the recvq, softsendq and hardsendq limits
#   no-throttle        exempts from connection throttling
# Note that `fakelag="no"` on a <connect> class is NOT a bypass: it only
# swaps the penalty from "pause parsing until it drains" to "QuitUser:
# Excess Flood" (users.cpp:287). Raising the threshold is what buys
# headroom; no-fakelag is what removes the ceiling.
<class name="Shutdown"
       commands="DIE RESTART REHASH LOADMODULE UNLOADMODULE RELOADMODULE GLOADMODULE GUNLOADMODULE GRELOADMODULE"
       privs="users/auspex channels/auspex servers/auspex users/mass-message channels/high-join-limit users/flood/no-fakelag users/flood/no-throttle users/flood/increased-buffers"
       usermodes="*"
       chanmodes="*"
       snomasks="*">
<class name="SACommands" commands="SAJOIN SAPART SANICK SAQUIT SATOPIC SAKICK SAMODE OJOIN">
# SAJOIN-others is a privilege, not a command: SACommands lets an oper
# SAJOIN themselves, but forcing *another* user in needs
# users/sajoin-others. Kept in its own class so only NetAdmin (the sole
# admin) gets it — the least-privilege tiers below must never inherit it.
<class name="SAJoinOthers" privs="users/sajoin-others">
<class name="ServerLink" commands="CONNECT SQUIT RCONNECT RSQUIT MKPASSWD ALLTIME SWHOIS JUMPSERVER LOCKSERV UNLOCKSERV" usermodes="*" chanmodes="*" snomasks="*" privs="servers/auspex">
<class name="BanControl" commands="KILL GLINE KLINE ZLINE QLINE ELINE TLINE RLINE CHECK NICKLOCK NICKUNLOCK SHUN CLONES CBAN CLOSE CLEARCHAN" usermodes="*" chanmodes="*">
<class name="OperChat" commands="WALLOPS GLOBOPS" usermodes="*" chanmodes="*" privs="users/mass-message">
<class name="HostCloak" commands="SETHOST SETIDENT SETIDLE CHGNAME CHGHOST CHGIDENT" usermodes="*" chanmodes="*" privs="users/auspex">

<type name="NetAdmin"
      classes="SACommands SAJoinOthers OperChat BanControl HostCloak Shutdown ServerLink"
      vhost="{{ ircd_oper_vhost }}&netsuffix;"
      modes="+s +cCqQ">

# Least-privilege tiers for day-to-day staff (no oper accounts use these
# yet — create <oper> entries of type GlobalOp/Helper as staff grows).
<type name="GlobalOp"
      classes="SACommands OperChat BanControl HostCloak ServerLink"
      vhost="oper&netsuffix;">
<type name="Helper"
      classes="HostCloak"
      vhost="helper&netsuffix;">

# Dashboard: exactly what the admin web UI needs and nothing else —
# REHASH plus G/K/Z-LINE management and the STATS letters that list
# them. No Shutdown (DIE/RESTART), no SA* overrides, no host changes.
# Usable only from the Docker network (host mask); the gateway connects
# to ircd:6697 over TLS on the trusted subnet.
<class name="Dashboard"
       commands="REHASH STATS GLINE KLINE ZLINE"
       privs="servers/auspex">
<type name="Dashboard"
      classes="Dashboard"
      vhost="dashboard&netsuffix;">
# Host mask covers both families: the gateway may arrive over IPv4 or
# IPv6 (dual-stack ircfiber_net) and a v6 source does not match the v4
# subnet — without the second mask OPER fails with 491.
<oper name="{{ ircd_dashboard_oper_name }}"
      hash="hmac-sha256"
      password="{{ ircd_dashboard_oper_hash }}"
      host="*@{{ ircd_trusted_subnet }} *@{{ ircd_trusted_subnet_v6 }}"
      type="Dashboard">

# FiberLogs: the #staff log bot. It needs exactly one capability an
# ordinary client lacks — receiving connect server notices — so the class
# grants no commands and no privs, only umode +s with snomasks c/C.
# Host-locked to the Docker network like the dashboard oper (both
# families: a v6 source does not match the v4 subnet).
# Deliberately no <badnick nick="FIBERLOGS">: unlike FiberServ (a BotServ
# pseudo-client), FiberLogs is a real client that sends NICK before it can
# OPER, so a reservation would lock our own bot out. The nick is protected
# by NickServ registration instead, exactly like FiberSupport.
<class name="Snotices"
       usermodes="s"
       snomasks="cC">
<type name="LogBot"
      classes="Snotices"
      vhost="logs&netsuffix;"
      modes="+s +cC">
<oper name="{{ ircd_logs_oper_name }}"
      hash="hmac-sha256"
      password="{{ ircd_logs_oper_hash }}"
      host="*@{{ ircd_trusted_subnet }} *@{{ ircd_trusted_subnet_v6 }}"
      type="LogBot">

# /OPER {{ ircd_oper_name }} <vault_ircd_oper_password>
# Password is stored as InspIRCd hmac-sha256 (base64(salt)$base64(hmac)),
# computed by the role from vault_ircd_oper_password.
<oper name="{{ ircd_oper_name }}"
      hash="hmac-sha256"
      password="{{ ircd_oper_password_hash }}"
      host="*@*"
      sslonly="{{ 'yes' if ircd_oper_sslonly else 'no' }}"
      type="NetAdmin">
