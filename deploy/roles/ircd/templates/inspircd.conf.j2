# {{ ansible_managed }}
# InspIRCd 4 — {{ ircd_server_name }} ({{ ircd_network_name }})
#
# Rendered by the ircd role. Mounted at /inspircd/conf/inspircd.conf.
# Reference: https://docs.inspircd.org/4/configuration/

<define name="netsuffix" value="{{ ircd_net_suffix }}">

#-#-#-#-#-#-#-#-#-#-#-#-  SERVER DESCRIPTION  -#-#-#-#-#-#-#-#-#-#-#-#-

<server name="{{ ircd_server_name }}"
        description="{{ ircd_server_description }}"
        id="{{ ircd_server_id }}"
        network="{{ ircd_network_name | replace(' ', '') }}">

<admin name="{{ ircd_admins[0].name }}"
       description="Server administrator"
       email="{{ ircd_admins[0].email }}">

#-#-#-#-#-#-#-#-#-#-#-#-   PORT CONFIGURATION   -#-#-#-#-#-#-#-#-#-#-#-

# Plaintext clients
<bind address="" port="{{ ircd_port_plain }}" type="clients">

# TLS clients. cert.pem/key.pem/dhparams.pem are generated by the image
# entrypoint on first boot (self-signed, CN={{ ircd_server_name }}).
<bind address="" port="{{ ircd_port_tls }}" type="clients" sslprofile="main">

{% if not ircd_is_leaf %}
# Server-to-server listener for the Anope link. Not published to the
# host; only reachable from {{ docker_ircfiber_subnet }}.
<bind address="" port="{{ ircd_link_port }}" type="servers">

#-#-#-#-#-#-#-#-#-#-#-#  SERVICES LINK (Anope)  -#-#-#-#-#-#-#-#-#-#-#-#

# <link> authenticates the Anope pseudo-server (Anope initiates to the
# servers bind above using vault_ircd_services_link_password). <uline>
# grants it services privileges (SVSJOIN, SASL forwarding, kill shield).
# Both names must match Anope's serverinfo name ({{ ircd_services_name }}).
<link name="{{ ircd_services_name }}"
      ipaddr="{{ ircd_services_net_alias }}"
      port="{{ ircd_link_port }}"
      sendpass="{{ vault_ircd_services_link_password }}"
      recvpass="{{ vault_ircd_services_link_password }}">
{% endif %}

# <uline> must be declared on every server on the network, leaf included:
# it is what grants Anope SVSJOIN/SASL/kill-shield rights here.
<uline server="{{ ircd_services_name }}">

#-#-#-#-#-#-#-#-#-#-  CONNECTIONS CONFIGURATION  -#-#-#-#-#-#-#-#-#-#-#
#
# Connect classes are matched top-down. The engine class MUST come first.

# IRC Fiber engine containers: every platform user is multiplexed
# through a handful of container IPs on {{ ircd_trusted_subnet }}, so
# this class has no clone limits, no DNS/ident lookups and no fakelag.
<connect name="ircfiber-engine"
         allow="{{ ircd_trusted_subnet }}"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="4M"
         softsendq="1M"
         recvq="64K"
         threshold="{{ ircd_engine_threshold }}"
         commandrate="{{ ircd_engine_commandrate }}"
         fakelag="no"
         localmax="0"
         globalmax="0"
         limit="{{ ircd_engine_class_limit }}"
         resolvehostnames="no"
         useident="no"
         usednsbl="no"
         useconnectban="no"
         useconnflood="no"
         usests="no"
{% if ircd_require_sasl %}
         requireaccount="yes"
{% endif %}
         modes="+x">

# Same exemptions for engine traffic arriving over IPv6 (dual-stack
# ircfiber_net). A v6 source does not match the v4 allow above and would
# otherwise fall into "main" (clone limits, throttling, connectban) —
# that Z-lined the admin dashboard path the day v6 was enabled.
<connect name="ircfiber-engine-v6"
         allow="{{ ircd_trusted_subnet_v6 }}"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="4M"
         softsendq="1M"
         recvq="64K"
         threshold="{{ ircd_engine_threshold }}"
         commandrate="{{ ircd_engine_commandrate }}"
         fakelag="no"
         localmax="0"
         globalmax="0"
         limit="{{ ircd_engine_class_limit }}"
         resolvehostnames="no"
         useident="no"
         usednsbl="no"
         useconnectban="no"
         useconnflood="no"
         usests="no"
{% if ircd_require_sasl %}
         requireaccount="yes"
{% endif %}
         modes="+x">

# Web sessions after the WEBIRC address swap: matched only for users the
# gateway module has tagged with gateway name "ircfiber" (modules.conf
# <gateway type="webirc">). m_gateway sets that tag BEFORE it changes the
# address, and LocalUser::ChangeRemoteAddress re-runs the class match at
# that instant, so the constraint is satisfied exactly when it is checked
# (a password= gate would not be: PASS arrives after WEBIRC). Engine bursts
# (autojoin, NAMES/WHO sweeps, backlog replay) still need engine-sized
# queues and no fakelag. useconnectban stays off: every web connection is
# gateway-authenticated (the engine only dials for a real websocket user),
# and m_connectban counts raw TCP connects per real IP with a counter that
# only clears on the hourly GC — any shared egress (VPN/proxy/NAT, or one
# human with a few tabs reconnecting) crosses threshold="8" within the hour
# and loop-bans every ~12 minutes. Per-IP protection here is the class
# clone caps plus FiberEye's connect_flood/nick_churn rules. useconnflood
# stays off for the same reason: it is a server-wide throttle checked
# against the post-swap class, and an engine restart reconnects every web
# user inside a few seconds.
#
# Enforced by the gateway module: without it the webirc= attribute is
# ignored and this allow="*" class ahead of "main" would catch every
# native client. Both live and die together.
<connect name="ircfiber-web"
         allow="*"
         webirc="ircfiber"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="4M"
         softsendq="1M"
         recvq="64K"
         threshold="{{ ircd_engine_threshold }}"
         commandrate="{{ ircd_engine_commandrate }}"
         fakelag="no"
         localmax="{{ ircd_web_class_ip_limit }}"
         globalmax="{{ ircd_web_class_ip_limit }}"
         limit="{{ ircd_engine_class_limit }}"
         resolvehostnames="no"
         useident="no"
         usednsbl="no"
         useconnectban="no"
         useconnflood="no"
         usests="no"
{% if ircd_require_sasl %}
         requireaccount="yes"
{% endif %}
         modes="+x">

# Loopback (127.0.0.1 / ::1) — the container's own healthcheck, and nothing
# else: only a process inside the ircd container can source from loopback, so
# exempting it grants the network nothing.
#
# A probe that opens a TCP connection to the client port is indistinguishable
# from an attack to m_connectban. At threshold=32 the 30s healthcheck tripped
# it every ~15.5 minutes, Z-lining 127.0.0.1 for 6h, which then re-armed on
# expiry and spammed every oper with ANNOUNCEMENT + REMOTEXLINE notices in a
# permanent ~6h loop. This is the identical failure the ircfiber-engine-v6
# block above documents — a source matching no earlier allow falls into
# "main" and gets throttled — so the fix is the same: give it a class.
#
# MUST stay above "main": connect classes match in file order and main's
# allow="*" would otherwise claim loopback first. That ordering is also why
# these cannot use parent="main" (a parent must already be defined), hence
# the explicit field list mirroring main.
<connect name="localhost"
         allow="127.0.0.1"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="1M"
         softsendq="512K"
         recvq="8K"
         threshold="10"
         commandrate="1000"
         fakelag="yes"
         localmax="8"
         globalmax="8"
         limit="8"
         resolvehostnames="no"
         useident="no"
         usednsbl="no"
         useconnectban="no"
         useconnflood="no"
         modes="+x">

<connect name="localhost-v6"
         allow="::1"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="1M"
         softsendq="512K"
         recvq="8K"
         threshold="10"
         commandrate="1000"
         fakelag="yes"
         localmax="8"
         globalmax="8"
         limit="8"
         resolvehostnames="no"
         useident="no"
         usednsbl="no"
         useconnectban="no"
         useconnflood="no"
         modes="+x">

# Everyone else (direct public connections to {{ ircd_port_plain }}/{{ ircd_port_tls }}).
<connect name="main"
         allow="*"
         maxchans="{{ ircd_max_channels_per_account }}"
         timeout="60"
         pingfreq="2m"
         hardsendq="1M"
         softsendq="512K"
         recvq="8K"
         threshold="10"
         commandrate="1000"
         fakelag="yes"
         localmax="{{ ircd_ip_limits_connections }}"
         globalmax="{{ ircd_ip_limits_connections }}"
         limit="{{ ircd_public_class_limit }}"
         resolvehostnames="yes"
         useident="no"
         usednsbl="{{ 'yes' if ircd_enable_dnsbl else 'no' }}"
{% if ircd_require_sasl %}
         requireaccount="yes"
{% endif %}
         modes="+x">

<cidr ipv4clone="32" ipv6clone="128">

# Reserve service nicknames so users cannot squat them (e.g. grabbing
# NickServ while services are split/restarting and harvesting IDENTIFY
# attempts). Mirrors the anope.example.conf aliases; explicit here so the
# reservation holds even when services are down.
<badnick nick="ALIS" reason="Reserved for services">
<badnick nick="BOTSERV" reason="Reserved for services">
<badnick nick="CHANFIX" reason="Reserved for services">
<badnick nick="CHANSERV" reason="Reserved for services">
<badnick nick="GAMESERV" reason="Reserved for services">
<badnick nick="GLOBAL" reason="Reserved for services">
<badnick nick="GROUPSERV" reason="Reserved for services">
<badnick nick="HELPSERV" reason="Reserved for services">
<badnick nick="HOSTSERV" reason="Reserved for services">
<badnick nick="INFOSERV" reason="Reserved for services">
<badnick nick="MEMOSERV" reason="Reserved for services">
<badnick nick="NICKSERV" reason="Reserved for services">
<badnick nick="OPERSERV" reason="Reserved for services">
<badnick nick="PROXYSCAN" reason="Reserved for services">
<badnick nick="RPGSERV" reason="Reserved for services">
<badnick nick="SASLSERV" reason="Reserved for services">
<badnick nick="STATSERV" reason="Reserved for services">
{% if ircd_services_bot %}
# The network's own BotServ bot (ircd_services_bot). Anope Q-lines this
# nick itself when the bot is created; reserving it here too keeps it
# unsquattable while services are down, same as the block above.
<badnick nick="{{ ircd_services_bot.nick | upper }}" reason="Reserved for services">
{% endif %}

#-#-#-#-#-#-#-#-#-#-  MISCELLANEOUS CONFIGURATION  -#-#-#-#-#-#-#-#-#-#

# motd.d/ is the one conf subdir the gateway may write (admin MOTD
# rotation, REHASHed through the oper session).
<files motd="motd.d/motd">

<dns timeout="5">

<maxlist chan="*" limit="100">

# allowmismatch: tolerate VF_OPTCOMMON module + extban drift against
# irc.netcrave.chat (they set it too). Required modules and the mode
# lists are still strictly compared — see modules.conf LINK COMPAT.
<options prefixquit="Quit: "
         prefixpart="&quot;"
         suffixpart="&quot;"
         syntaxhints="yes"
         announcets="yes"
         maskinlist="yes"
         maskintopic="yes"
         pingwarning="15"
         serverpingfreq="1m"
         defaultmodes="not"
         xlinequit="%fulltype%: %reason%"
         modesinlist="opers"
         allowmismatch="yes">

<performance netbuffersize="10240"
             somaxconn="128"
             softlimit="{{ ircd_softlimit }}"
             quietbursts="yes"
             timeskipwarn="2s">

<security announceinvites="dynamic"
          hideservices="no"
          flatlinks="no"
          hidesplits="{{ 'yes' if ircd_hide_splits else 'no' }}"
          hideservicekills="yes"
          hideulines="yes"
          customversion="{{ ircd_custom_version }}"
          maphide="https://ircfiber.com/network"
          maxtargets="20"
          restrictbannedusers="yes"
          genericoper="no"
          userstats="Pu">

<limits maxaway="{{ ircd_awaylen }}"
        maxchan="{{ ircd_channellen }}"
        maxhost="64"
        maxuser="{{ ircd_identlen }}"
        maxkey="30"
        maxkick="{{ ircd_kicklen }}"
        maxmodes="20"
        maxnick="{{ ircd_nicklen }}"
        maxquit="300"
        maxreal="130"
        maxtopic="{{ ircd_topiclen }}">

<whowas groupsize="10" maxgroups="10000" maxkeep="3d">

# Logs go to the container stdout (fluent-bit ships them to SigNoz).
<log method="stdout"
     level="{{ ircd_log_level }}"
     type="* -USERINPUT -USEROUTPUT">

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#  INCLUDES  -#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

<include file="modules.conf">
<include file="opers.conf">
<include file="custom.conf">
# Anope aliases (/NS, /CS, /ID ...), reserved nicks and filter exemptions.
<include file="&dir.example;/services/anope.example.conf">
