# IRC Fiber bridge image: Anope 2.1 with the bridgeserv module (Discord <->
# IRC relay), run as a bridge-only sidecar next to the anope/anope:2.0.20
# services container.
#
# It is deliberately not the services image. bridgeserv is 2.1 only, and 2.1
# removed db_flatfile and m_xmlrpc_main, both of which the gateway depends on
# against the 2.0.20 instance. This image carries no account database of the
# network: the only accounts it knows are the two which authorise BridgeServ.
#
# Both stages pin the same alpine so the daemon is not compiled against one
# musl/libstdc++ and run against another. The source (including the vendored
# DPP under vendor/brainboxdotcc) is cloned in the builder stage at
# ANOPE_COMMIT, exactly as Containerfile.ircd clones InspIRCd.
#
# Build context is the site repo root (what the root Makefile's SHIP_SH
# passes):
#   docker build -f deploy/roles/ircd/files/Containerfile.anope --target runtime-anope .
#
# Image contract, which deploy/roles/ircd/tasks/bridge.yml relies on:
#   /anope/bin/anope              the daemon, run with --nofork
#   /anope/modules/bridgeserv.so  the bridge module
#   /anope/conf/anope.conf        bind-mounted read-only by the role
#   /anope/data                   the volume (db_json database + backups)
#   uid/gid 10000

# The fork's branch, not paigeadelethompson/master: the image pins the exact
# commit that is live, and the clone below only carries the history of the
# named branch, so the branch must be the one the commit is on. Everything on
# it is submitted upstream as pull requests from kevinpostal/anope.
ARG ANOPE_REPO=https://github.com/kevinpostal/anope.git
ARG ANOPE_BRANCH=bridgeserv-ircv3
ARG ANOPE_COMMIT=8a80d5009af56fc330a9e196abdd48143fc662ac

# Debian, not alpine, and NOT interchangeable: on musl the vendored DPP
# segfaults the moment Discord sends a guild with members. Its timestamp
# parser builds a named std::locale, which Alpine's libstdc++ cannot do —
# backtrace from a RelWithDebInfo build of this image on the live network:
#
#   __strchrnul (s=0x1) at src/string/strchrnul.c:19
#   std::locale::_Impl::_Impl(char const*, unsigned long)
#   crossplatform_strptime (s="2025-06-13T21:24:04")
#   dpp::set_ts_not_null (keyname="joined_at")
#   dpp::guild_member::fill_from_json
#   dpp::events::guild_create::handle
#
# The process died with SIGSEGV about a second after every
# "connected to Discord", so the container crash-looped and flapped the
# services link on the network. Every other part of the image contract is
# unchanged: /anope/bin/anope, /anope/modules/bridgeserv.so,
# /anope/conf/anope.conf, /anope/data, uid/gid 10000.

FROM debian:trixie-slim AS builder-anope
ARG ANOPE_REPO
ARG ANOPE_BRANCH
ARG ANOPE_COMMIT
# zlib1g-dev is required even though upstream's own CI omits it: DPP's
# vendor/CMakeLists.txt calls find_package(ZLIB REQUIRED). gettext supplies
# the libintl headers, without which Anope logs "Unable to initialize
# languages, gettext and/or libintl were not installed at build time" on
# every start and serves every reply unlocalised.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git pkg-config gettext \
      libssl-dev zlib1g-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --branch ${ANOPE_BRANCH} ${ANOPE_REPO} /anope-src \
 && git -C /anope-src checkout --detach ${ANOPE_COMMIT}
WORKDIR /anope-src
# The `test -f` lines are the build gate. CMake skips a module whose
# dependencies it cannot detect rather than failing the build, so without
# them an OpenSSL or DPP detection failure would silently ship an Anope with
# no bridge and only surface as a missing BridgeServ in prod.
RUN cmake -B build -D CMAKE_BUILD_TYPE=Release -D INSTDIR=/anope -G Ninja \
 && ninja -C build install \
 && test -f /anope/modules/bridgeserv.so \
 && test -f /anope/bin/anope

FROM debian:trixie-slim AS runtime-anope
# ca-certificates is required: DPP verifies discord.com's chain, and without
# a trust store the gateway connection fails before it is even attempted.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libssl3 zlib1g libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 10000 anope \
 && useradd -u 10000 -g 10000 -d /anope -M -s /usr/sbin/nologin anope
COPY --from=builder-anope --chown=10000:10000 /anope/ /anope/
# The rendered config is bind-mounted over conf/anope.conf; the shipped
# examples stay in the image so an operator can read them in place.
RUN mkdir -p /anope/data && chown 10000:10000 /anope/data
USER 10000
WORKDIR /anope
ENTRYPOINT ["/anope/bin/anope", "--nofork"]
