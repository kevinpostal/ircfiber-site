# IRC Fiber services image: Anope 2.1 with the bridgeserv module (Discord <->
# IRC relay). This is THE services instance of the network — accounts,
# channels, BotServ, OperServ and BridgeServ all live in the one process.
#
# It replaced two containers: anope/anope:2.0.20 (pinned there for
# db_flatfile + m_xmlrpc_main) and a bridge-only 2.1 sidecar (bridgeserv is
# 2.1 only). In 2.1 the database is db_json, the gateway drives services over
# the authenticated jsonrpc listener (rpc_user, rpc_data and our
# rpc_registered), and db_flatfile survives only as a load-only importer for
# the one-shot migration of the 2.0 anope.db (deploy/roles/ircd/tasks/
# services.yml).
#
# Both stages pin the same debian so the daemon is not compiled against one
# libstdc++ and run against another. The source (including the vendored DPP
# under vendor/brainboxdotcc) is cloned in the builder stage at ANOPE_COMMIT,
# exactly as Containerfile.ircd clones InspIRCd.
#
# Build context is the site repo root (what the root Makefile's SHIP_SH
# passes):
#   docker build -f deploy/roles/ircd/files/Containerfile.anope --target runtime-anope .
#
# Image contract, which deploy/roles/ircd/tasks/services.yml relies on:
#   /anope/bin/anope                the daemon, run with --nofork
#   /anope/modules/*.so             every module services.conf.j2 loads (gated below)
#   /anope/conf/anope.conf          the rendered services.conf, bind-mounted
#                                   read-only by the role under the name the
#                                   2.1 daemon reads, plus nickserv.conf /
#                                   operserv.conf / global.conf /
#                                   services.motd next to it; the shipped
#                                   *.example.conf stay in the image and are
#                                   included from it
#   uid/gid 10000

# The fork's branch, not anope/2.1: the image pins the exact commit that is
# live, and the clone below only carries the history of the named branch, so
# the branch must be the one the commit is on. Everything on it is submitted
# upstream as pull requests from kevinpostal/anope. ts6link is
# bridgeserv-mentions plus modules/ts6link (the TS6 link bridge that the
# ircfiber-ts6link sidecar loads; tasks/ts6link.yml).
ARG ANOPE_REPO=https://github.com/kevinpostal/anope.git
ARG ANOPE_BRANCH=ts6link
ARG ANOPE_COMMIT=f6e46425b6747e1b34ff939ca5e8d6028cd4dae3

# Debian, not alpine, and NOT interchangeable: on musl the vendored DPP
# segfaults the moment Discord sends a guild with members. Its timestamp
# parser builds a named std::locale, which Alpine's libstdc++ cannot do —
# backtrace from a RelWithDebInfo build of this image on the live network:
#
#   __strchrnul (s=0x1) at src/string/strchrnul.c:19
#   std::locale::_Impl::_Impl(char const*, unsigned long)
#   crossplatform_strptime (s="2025-06-13T21:24:04")
#   dpp::set_ts_not_null (keyname="joined_at")
#   dpp::guild_member::fill_from_json
#   dpp::events::guild_create::handle
#
# The process died with SIGSEGV about a second after every
# "connected to Discord", so the container crash-looped and flapped the
# services link on the network.

FROM debian:trixie-slim AS builder-anope
ARG ANOPE_REPO
ARG ANOPE_BRANCH
ARG ANOPE_COMMIT
# zlib1g-dev is required even though upstream's own CI omits it: DPP's
# vendor/CMakeLists.txt calls find_package(ZLIB REQUIRED). gettext supplies
# the libintl headers, without which Anope logs "Unable to initialize
# languages, gettext and/or libintl were not installed at build time" on
# every start and serves every reply unlocalised.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git pkg-config gettext \
      libssl-dev zlib1g-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Three patches the migration and the gateway integration depend on:
#
#   anope-rpc-command-unregistered.patch  rpc_user: `allowunregistered = yes`
#     lets anope.command run as a nick that has no account, exactly like
#     2.0's XML-RPC `command` did. That is how the gateway registers a
#     website user's nick offline (`NickServ REGISTER` registers the source
#     nick); stock 2.1 answers "No such account" instead.
#   anope-rpc-registered.patch  new module rpc_registered: exposes
#     ChannelInfo (anope.listRegisteredChannels / anope.registeredChannel)
#     and account suspensions (anope.listSuspendedAccounts), neither of which
#     rpc_data has. Pure addition, so it survives ANOPE_COMMIT bumps.
#   anope-nickcore-registered-backfill.patch  src/nickalias.cpp: a 2.0
#     NickCore has no registration time, so upstream's "2.0 compatibility"
#     backfill (older alias wins) never fired against the 0 it loaded as,
#     and every migrated account reported registered=0 forever. Verified on
#     a migrated rig database before the patch; correct after it.
#
# They are applied as the last command of the clone layer so they are a
# build gate: `git apply` fails the build if a patch stops matching after an
# ANOPE_COMMIT bump. Never relax it with --3way or `|| true` — an unpatched
# image would silently ship a services the gateway cannot provision through.
COPY deploy/roles/ircd/files/anope-rpc-command-unregistered.patch \
     deploy/roles/ircd/files/anope-rpc-registered.patch \
     deploy/roles/ircd/files/anope-nickcore-registered-backfill.patch \
     /tmp/patches/
# ssl_openssl lives in modules/extra/, which Anope's CMake deliberately
# does not build ("copy or symlink files out of it"); the ts6link sidecar
# dials its TLS peer through it, so it is copied into modules/ here. The
# builder already has libssl-dev (DPP) and the runtime libssl3.
RUN git clone --branch ${ANOPE_BRANCH} ${ANOPE_REPO} /anope-src \
 && git -C /anope-src checkout --detach ${ANOPE_COMMIT} \
 && git -C /anope-src apply --verbose \
      /tmp/patches/anope-rpc-command-unregistered.patch \
      /tmp/patches/anope-rpc-registered.patch \
      /tmp/patches/anope-nickcore-registered-backfill.patch \
 && cp /anope-src/modules/extra/ssl_openssl.cpp /anope-src/modules/ssl_openssl.cpp
WORKDIR /anope-src
# The `test -f` lines are the build gate. CMake skips a module whose
# dependencies it cannot detect rather than failing the build, so without
# them an OpenSSL or DPP detection failure would silently ship an Anope with
# no bridge and only surface as a missing BridgeServ in prod. Every module
# services.conf.j2 and ts6link.conf.j2 load is listed (ssl_openssl is what
# the ts6link sidecar dials its TLS peer with): a missing one aborts the
# build here instead of aborting services at start on the live network.
RUN cmake -B build -D CMAKE_BUILD_TYPE=Release -D INSTDIR=/anope -G Ninja \
 && ninja -C build install \
 && test -f /anope/bin/anope \
 && for m in bridgeserv db_json db_flatfile enc_bcrypt enc_sha256 httpd jsonrpc \
             rpc_user rpc_data rpc_registered inspircd nickserv chanserv botserv \
             hostserv memoserv operserv global fantasy help ts6link ssl_openssl; do \
      test -f /anope/modules/$m.so || { echo "missing module $m.so" >&2; exit 1; }; \
    done

FROM debian:trixie-slim AS runtime-anope
# ca-certificates is required: DPP verifies discord.com's chain, and without
# a trust store the gateway connection fails before it is even attempted.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libssl3 zlib1g libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 10000 anope \
 && useradd -u 10000 -g 10000 -d /anope -M -s /usr/sbin/nologin anope
COPY --from=builder-anope --chown=10000:10000 /anope/ /anope/
# The rendered configs are bind-mounted over conf/; the shipped examples
# stay in the image because services.conf includes them.
RUN mkdir -p /anope/data && chown 10000:10000 /anope/data
USER 10000
WORKDIR /anope
ENTRYPOINT ["/anope/bin/anope", "--nofork"]
