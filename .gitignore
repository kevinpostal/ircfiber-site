# Local build outputs — regenerated locally, never committed.
# (Note: public/dist/ itself IS committed by convention; only the
# vite cache dir below is excluded. Legacy .vitest-attachments PNGs
# already tracked stay tracked; new test-run screenshots are ignored.)
backend/irc-fiber
*.a
public/dist/.vite/
frontend/.vitest-attachments/
# vitest browser-mode auto-generated failure/run screenshots (App.test.ts
# etc.) — the comment above already documented this as ignored; the
# pattern itself was missing, so `_require_clean` tripped on every leftover
# test run (2026-09-07: 3 stray dirs blocked `make deploy-blue`).
**/__screenshots__/
# Ansible vault password — local secret, never committed.
deploy/.vault_pass.txt

# Local test binaries — build outputs.
backend/egress-test
backend/bnc-wire-test
backend/parser-test
backend/support-format-test
backend/services-test

# Image tarball staged between the remote builder and the deploy target
.deploy-cache/

# macOS finder droppings — untracked junk otherwise trips the deploy clean-tree guard
.DS_Store

# Compiled dub test-config binaries (services-test, ircd-test, logs-test, ...)
backend/*-test
